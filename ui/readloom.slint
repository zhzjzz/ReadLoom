                                viewport-width: self.width;
                                viewport-height: Math.max(self.height, double-reader-column.preferred-height);
                                double-reader-column := VerticalLayout {
                                    x: Math.max(root.settings-horizontal-margin * 1px, (parent.width - root.settings-content-width * 1px) / 2);
                                    width: Math.min(parent.width - root.settings-horizontal-margin * 2px, root.settings-content-width * 1px);
                                    padding-top: root.settings-vertical-margin * 1px;
                                    padding-bottom: root.settings-vertical-margin * 1px;
                                    for pair in root.paragraph-rows : pair-row := Rectangle {
                                    property <int> measure-generation: root.geometry-measure-generation;
                                    property <string> first-live-edit-text: pair.first.text;
                                    property <string> second-live-edit-text: pair.has-second ? pair.second.text : "";
                                    property <length> first-live-editor-height: Math.max(first-editor-measure.preferred-height, root.settings-font-size * 1px);
                                    property <length> second-live-editor-height: Math.max(second-editor-measure.preferred-height, root.settings-font-size * 1px);
                                    height: pair.first.kind == "image" || (pair.has-second && pair.second.kind == "image")
                                        ? 352px
                                        : pair.first.kind == "blank"
                                        ? 24px
