                                        font-size: root.document-kind == "EPUB" && !root.settings-epub-override-font-size ? 18px : root.settings-font-size * 1px;
                                        font-weight: root.settings-font-weight;
                                        letter-spacing: (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px;
                                        wrap: word-wrap;
                                    }
                                    first-editor-measure := Text {
                                        visible: root.edit-mode && pair.first.editable;
                                        opacity: 0;
                                        x: first-body.x; y: first-body.y; width: first-body.width;
                                        text: pair-row.first-live-edit-text;
                                        font-family: first-body.font-family; font-size: first-body.font-size; font-weight: first-body.font-weight; letter-spacing: first-body.letter-spacing;
                                        horizontal-alignment: first-body.horizontal-alignment;
                                        wrap: word-wrap;
                                    }
                                    second-editor-measure := Text {
                                        visible: pair.has-second;
                                        opacity: 0;
                                        x: (parent.width - 28px) / 2 + 28px; y: 13px; width: (parent.width - 28px) / 2;
                                        text: pair-row.second-live-edit-text;
                                        font-family: root.document-kind == "EPUB" && !root.settings-epub-override-font ? "Microsoft YaHei UI" : root.settings-font-family;
                                        font-size: root.document-kind == "EPUB" && !root.settings-epub-override-font-size ? 18px : root.settings-font-size * 1px;
                                        font-weight: root.settings-font-weight;
                                        letter-spacing: (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px;
                                        horizontal-alignment: left;
                                        wrap: word-wrap;
                                    }
                                    if root.edit-mode && pair.first.editable : first-editor := TextInput {
