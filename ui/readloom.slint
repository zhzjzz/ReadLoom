                                            root.set-epub-image-alt(paragraph.block-id, self.text);
                                        }
                                    }
                                    if root.edit-mode && paragraph.kind == "image" : ActionButton {
                                        x: Math.max(root.settings-horizontal-margin * 1px, (parent.width - root.settings-content-width * 1px) / 2)
                                            + Math.max(160px, Math.min(parent.width - root.settings-horizontal-margin * 2px, root.settings-content-width * 1px) - 96px) + 8px;
                                        y: 304px;
                                        width: 88px;
                                        height: 34px;
                                        text: "删除图片";
                                        clicked => {
