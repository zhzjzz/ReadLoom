                                        edited => { root.active-paragraph-index = pair.second.index; root.replace-block-text(pair.second.block-id, self.text, self.cursor-position_byte-offset); }
                                        key-pressed(event) => {
                                            if self.preedit-text.is-empty && self.cursor-position-byte-offset == self.anchor-position-byte-offset {
                                                if event.text == Key.Backspace && root.join-adjacent-text(pair.second.block-id, "previous", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) { return accept; }
                                                if event.text == Key.Delete && root.join-adjacent-text(pair.second.block-id, "next", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) { return accept; }
                                            }
                                            return reject;
                                        }
                                        cursor-position-changed(position) => {
                                            if !root.view-anchor-restore-pending {
                                                root.active-paragraph-index = pair.second.index;
                                                root.capture-view-anchor(pair.second.block-id, self.cursor-position-byte-offset, self.y / 1px + pair-row.y / 1px + root.reader-viewport-y / 1px);
                                            }
                                        }
                                    }
                                    if pair.first.kind == "image" && pair.first.has-image : Image {
                                        x: 0px;
                                        y: 14px;
                                        width: (parent.width - 28px) / 2;
                                        height: 270px;
                                        source: pair.first.image;
                                        image-fit: contain;
                                    }
                                    if pair.has-second && pair.second.kind == "image" && pair.second.has-image : Image {
