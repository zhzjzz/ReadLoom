import { LineEdit, ListView, ScrollView, Slider, TextEdit } from "std-widgets.slint";

export struct LibraryBook {
    title: string,
    subtitle: string,
    path: string,
    kind: string,
    available: bool,
    group-name: string,
    cover: image,
    has-cover: bool,
}

export struct LibraryBookRow {
    first: LibraryBook,
    second: LibraryBook,
    third: LibraryBook,
    fourth: LibraryBook,
    fifth: LibraryBook,
    has-second: bool,
    has-third: bool,
    has-fourth: bool,
    has-fifth: bool,
}

export struct LibraryShelf {
    id: string,
    name: string,
    count: int,
}

export struct ChapterItem {
    title: string,
    chapter-index: int,
    paragraph-index: int,
    line-number: int,
}

export struct ParagraphItem {
    block-id: string,
    editable: bool,
    text: string,
    kind: string,
    index: int,
    chapter-index: int,
    image: image,
    has-image: bool,
}

export struct ParagraphRow {
    first: ParagraphItem,
    second: ParagraphItem,
    has-second: bool,
}

export struct SearchItem {
    label: string,
    preview: string,
    chapter-index: int,
    paragraph-index: int,
}

export struct BookmarkItem {
    id: string,
    label: string,
    detail: string,
    chapter-index: int,
    paragraph-index: int,
}

export struct OpenDocumentTab {
    title: string,
    path: string,
    kind: string,
    active: bool,
}

// Readloom's semantic design system. Concrete values live here so the
// application chrome, settings and reading surfaces share one visual language.
// The Rust host updates `dark` whenever the effective application theme changes.
export global DesignTokens {
    in-out property <bool> dark: false;

    // Spacing
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-10: 40px;

    // Radius
    out property <length> radius-small: 4px;
    out property <length> radius-medium: 8px;
    out property <length> radius-large: 12px;

    // Typography
    out property <length> type-page-title: 24px;
    out property <length> type-section-title: 13px;
    out property <length> type-item-title: 12px;
    out property <length> type-body: 11px;
    out property <length> type-secondary: 10px;
    out property <length> type-caption: 9px;
    out property <int> weight-page-title: 720;
    out property <int> weight-section-title: 700;
    out property <int> weight-item-title: 620;
    out property <int> weight-body: 520;

    // Semantic color roles
    out property <brush> background: dark ? #181b21 : #f5f6f8;
    out property <brush> surface: dark ? #20242b : #ffffff;
    out property <brush> surface-subtle: dark ? #252a33 : #f8f9fb;
    out property <brush> surface-hover: dark ? #2b313b : #eef1f5;
    out property <brush> surface-active: dark ? #303744 : #e8edf5;
    out property <brush> reader-background: dark ? #1b1e23 : #faf9f6;
    out property <brush> reader-text: dark ? #e1e4e9 : #292722;
    out property <brush> reader-text-secondary: dark ? #b8bec7 : #57534c;
    out property <brush> border: dark ? #3a414d : #cfd5de;
    out property <brush> border-subtle: dark ? #303641 : #e1e5eb;
    out property <brush> text-primary: dark ? #edf0f4 : #1f2530;
    out property <brush> text-secondary: dark ? #b7bec9 : #5f6876;
    out property <brush> text-muted: dark ? #8d96a4 : #7d8795;
    out property <brush> text-disabled: dark ? #626b78 : #a2a9b3;
    out property <brush> accent: dark ? #79a2ff : #2f64cf;
    out property <brush> accent-hover: dark ? #8eb1ff : #2455b7;
    out property <brush> accent-muted: dark ? #293b61 : #e8f0ff;
    out property <brush> accent-border: dark ? #4c6fae : #9fb8e9;
    out property <brush> danger: dark ? #ff9a91 : #bd3d35;
    out property <brush> danger-muted: dark ? #4a2c2d : #fff0ef;
    out property <brush> warning: dark ? #efbd78 : #9b632c;
    out property <brush> success: dark ? #78ca8a : #2f8a49;
    out property <brush> focus: dark ? #9cb9ff : #315fc4;
}

component VectorIcon inherits Rectangle {
    in property <string> name;
    in property <color> icon-color: DesignTokens.text-secondary;
    background: transparent;

    Path {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.name == "library"
            ? "M4 4 H8 V20 H4 Z M10 4 H14 V20 H10 Z M16 6 L19.5 5 L22.5 18 L19 19 Z"
            : root.name == "document"
                ? "M6 2 H14 L18 6 V22 H6 Z M14 2 V7 H18 M9 12 H15 M9 16 H15"
                : root.name == "search"
                    ? "M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 M15.5 15.5 L21 21"
                : root.name == "bookmark"
                    ? "M6 3 H18 V21 L12 17 L6 21 Z"
                : root.name == "edit"
                    ? "M4 20 L5 15 L16 4 L20 8 L9 19 Z M14.5 5.5 L18.5 9.5"
                : root.name == "open"
                    ? "M4 7 H10 L12 9 H20 V20 H4 Z M12 3 V15 M8.5 11.5 L12 15 L15.5 11.5"
                : root.name == "save"
                    ? "M5 3 H17 L20 6 V21 H4 V3 Z M8 3 V9 H16 V3 M8 16 H16"
                : root.name == "previous"
                    ? "M15.5 5 L8.5 12 L15.5 19"
                : root.name == "next"
                    ? "M8.5 5 L15.5 12 L8.5 19"
                : "M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 M12 3 V5 M12 19 V21 M3 12 H5 M19 12 H21 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M18.4 5.6 L17 7 M7 17 L5.6 18.4";
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component IconSlot inherits Rectangle {
    in property <string> name;
    in property <color> icon-color: DesignTokens.text-secondary;
    in property <length> icon-size: 18px;
    background: transparent;

    VectorIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        name: root.name;
        icon-color: root.icon-color;
    }
}

component StatusDotSlot inherits Rectangle {
    in property <color> dot-color: DesignTokens.success;
    background: transparent;

    Rectangle {
        x: (parent.width - 7px) / 2;
        y: (parent.height - 7px) / 2;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.dot-color;
    }
}

component BrandContent inherits Rectangle {
    background: transparent;

    HorizontalLayout {
        padding-left: DesignTokens.space-4;
        padding-right: DesignTokens.space-3;
        spacing: DesignTokens.space-2;
        Rectangle {
            width: 23px;
            background: transparent;
            Rectangle {
                y: (parent.height - 23px) / 2;
                width: 23px;
                height: 23px;
                border-radius: DesignTokens.radius-small;
                background: DesignTokens.text-primary;
                Text {
                    text: "R";
                    color: #ffffff;
                    font-family: "Cascadia Mono";
                    font-size: DesignTokens.type-item-title;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: "Readloom";
            color: DesignTokens.text-primary;
            font-size: 14px;
            font-weight: DesignTokens.weight-section-title;
            vertical-alignment: center;
        }
        Text {
            text: "阅织";
            color: DesignTokens.text-muted;
            font-size: DesignTokens.type-item-title;
            vertical-alignment: center;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: 58px;
    border-radius: DesignTokens.radius-small;
    border-width: 1px;
    border-color: !root.enabled
        ? DesignTokens.border-subtle
        : root.primary ? DesignTokens.accent
        : root.danger ? DesignTokens.danger
        : DesignTokens.border;
    background: !root.enabled
        ? DesignTokens.surface-subtle
        : root.primary
            ? (button-touch.pressed ? DesignTokens.accent-hover : button-touch.has-hover ? DesignTokens.accent-hover : DesignTokens.accent)
            : root.danger
                ? (button-touch.pressed || button-touch.has-hover ? DesignTokens.danger : DesignTokens.danger-muted)
                : (button-touch.pressed ? DesignTokens.surface-active : button-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);

    Text {
        text: root.text;
        color: !root.enabled ? DesignTokens.text-disabled
            : root.primary ? #ffffff
            : root.danger && !button-touch.has-hover && !button-touch.pressed ? DesignTokens.danger
            : root.danger ? #ffffff : DesignTokens.text-secondary;
        font-size: DesignTokens.type-body;
        font-weight: DesignTokens.weight-item-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

component ToolbarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: 64px;
    border-radius: DesignTokens.radius-small;
    background: !root.enabled ? transparent
        : root.active ? DesignTokens.accent-muted
        : toolbar-touch.pressed ? DesignTokens.surface-active
        : toolbar-touch.has-hover ? DesignTokens.surface-hover : transparent;

    HorizontalLayout {
        padding-left: DesignTokens.space-2;
        padding-right: DesignTokens.space-2;
        spacing: 6px;
        IconSlot { width: 16px; icon-size: 16px; name: root.icon; icon-color: !root.enabled ? DesignTokens.text-disabled : root.active ? DesignTokens.accent : DesignTokens.text-secondary; }
        Text { text: root.label; color: !root.enabled ? DesignTokens.text-disabled : root.active ? DesignTokens.accent : DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: root.active ? DesignTokens.weight-section-title : DesignTokens.weight-body; vertical-alignment: center; }
    }

    toolbar-touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: DesignTokens.radius-small;
    background: !root.enabled ? transparent
        : root.active ? DesignTokens.accent-muted
        : icon-touch.pressed ? DesignTokens.surface-active
        : icon-touch.has-hover ? DesignTokens.surface-hover : transparent;
    IconSlot { x: 8px; y: 8px; width: 18px; height: 18px; icon-size: 18px; name: root.icon; icon-color: !root.enabled ? DesignTokens.text-disabled : root.active ? DesignTokens.accent : DesignTokens.text-secondary; }
    icon-touch := TouchArea { enabled: root.enabled; accessible-role: button; accessible-label: root.label; clicked => { root.clicked(); } }
}

component DocumentTabButton inherits Rectangle {
    in property <OpenDocumentTab> tab;
    callback selected();
    callback closed();
    width: 174px;
    height: 34px;
    border-radius: DesignTokens.radius-small;
    border-width: 1px;
    border-color: root.tab.active ? DesignTokens.accent-border : DesignTokens.border-subtle;
    background: root.tab.active ? DesignTokens.accent-muted : tab-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
    tab-touch := TouchArea { accessible-role: button; accessible-label: root.tab.title; clicked => { root.selected(); } }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 5px;
        spacing: 5px;
        Text { width: 34px; text: root.tab.kind; color: root.tab.active ? DesignTokens.accent : DesignTokens.text-muted; font-family: "Cascadia Mono"; font-size: 8px; font-weight: 700; vertical-alignment: center; }
        Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: root.tab.title; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; font-weight: root.tab.active ? 680 : DesignTokens.weight-body; overflow: elide; vertical-alignment: center; }
        Rectangle {
            width: 26px;
            height: 24px;
            border-radius: DesignTokens.radius-small;
            background: close-touch.has-hover ? DesignTokens.surface-active : transparent;
            Text { text: "×"; color: DesignTokens.text-muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            close-touch := TouchArea { accessible-role: button; accessible-label: "关闭图书"; clicked => { root.closed(); } }
        }
    }
}

component SettingValueButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: 68px;
    border-radius: DesignTokens.radius-small;
    border-width: 1px;
    border-color: root.selected ? DesignTokens.accent : DesignTokens.border;
    background: !root.enabled ? DesignTokens.surface-subtle
        : root.selected ? DesignTokens.accent-muted
        : value-touch.pressed ? DesignTokens.surface-active
        : value-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
    Text {
        text: root.text;
        color: !root.enabled ? DesignTokens.text-disabled : root.selected ? DesignTokens.accent : DesignTokens.text-secondary;
        font-size: DesignTokens.type-body;
        font-weight: root.selected ? DesignTokens.weight-section-title : DesignTokens.weight-item-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    value-touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

component SettingSwitch inherits Rectangle {
    in property <bool> active;
    in property <bool> enabled: true;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: !root.enabled ? DesignTokens.border-subtle
        : root.active ? (switch-touch.pressed ? DesignTokens.accent-hover : DesignTokens.accent)
        : switch-touch.has-hover ? DesignTokens.text-muted : DesignTokens.border;
    Rectangle {
        x: root.active ? 20px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.enabled ? #ffffff : DesignTokens.text-disabled;
    }
    switch-touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.active ? "已开启" : "已关闭";
        clicked => { root.toggled(); }
    }
}

component BackgroundSettingControl inherits Rectangle {
    in property <string> label: "背景图片";
    in property <float> display-opacity;
    in property <image> preview-image;
    in property <bool> has-preview;
    callback opacity-changed(float);
    callback choose();
    callback clear();

    height: 110px;
    background: transparent;

    VerticalLayout {
        spacing: DesignTokens.space-2;
        Text { height: 18px; text: root.label; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; }
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 104px;
                border-radius: DesignTokens.radius-medium;
                border-width: 1px;
                border-color: DesignTokens.border;
                background: DesignTokens.surface-active;
                clip: true;
                if root.has-preview : Image {
                    source: root.preview-image;
                    image-fit: cover;
                    opacity: root.display-opacity;
                }
                if !root.has-preview : Text {
                    text: "暂无预览";
                    color: DesignTokens.text-muted;
                    font-size: DesignTokens.type-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: 6px;
                    y: parent.height - 20px;
                    width: 36px;
                    height: 15px;
                    border-radius: 4px;
                    background: #99000000;
                    Text { text: "预览"; color: #ffffff; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            VerticalLayout {
                spacing: 5px;
                HorizontalLayout {
                    height: 26px;
                    spacing: 8px;
                    Rectangle {
                        width: 112px;
                        background: transparent;
                        Text { text: "显示强度 " + Math.round(root.display-opacity * 100) + "%"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-body; vertical-alignment: center; }
                        TouchArea {
                            scroll-event(event) => {
                                if (event.delta-y < 0) {
                                    root.opacity-changed(Math.min(1, root.display-opacity + 0.01));
                                    return accept;
                                } else if (event.delta-y > 0) {
                                    root.opacity-changed(Math.max(0, root.display-opacity - 0.01));
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                    Slider {
                        accessible-id: "background-opacity-slider";
                        minimum: 0;
                        maximum: 100;
                        step: 1;
                        value: root.display-opacity * 100;
                        changed(value) => { root.opacity-changed(value / 100); }
                    }
                }
                Text { height: 16px; text: "拖动滑块调节 0–100%；在百分比上滚轮可微调。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; vertical-alignment: center; }
                HorizontalLayout {
                    height: 34px;
                    spacing: 7px;
                    ActionButton { text: "选择背景"; clicked => { root.choose(); } }
                    ActionButton { text: "清除"; enabled: root.has-preview; clicked => { root.clear(); } }
                    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                }
            }
        }
    }
}

component StepSettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> value;
    in property <string> decrease-text: "−";
    in property <string> increase-text: "+";
    callback decrease();
    callback increase();

    height: root.description == "" ? 42px : 52px;
    border-radius: DesignTokens.radius-small;
    background: step-touch.has-hover ? DesignTokens.surface-hover : transparent;

    HorizontalLayout {
        padding-left: DesignTokens.space-3;
        padding-right: DesignTokens.space-2;
        spacing: DesignTokens.space-2;
        VerticalLayout {
            min-width: 156px;
            vertical-stretch: 1;
            spacing: 2px;
            Text { text: root.label; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
            if root.description != "" : Text { text: root.description; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center; }
        }
        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
        Text { width: 86px; text: root.value; color: DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; horizontal-alignment: right; vertical-alignment: center; }
        SettingValueButton { width: 48px; height: 30px; text: root.decrease-text; clicked => { root.decrease(); } }
        SettingValueButton { width: 48px; height: 30px; text: root.increase-text; clicked => { root.increase(); } }
    }
    step-touch := TouchArea { enabled: false; }
}

component ToggleSettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> active;
    callback toggled();

    height: root.description == "" ? 44px : 52px;
    border-radius: DesignTokens.radius-small;
    background: toggle-touch.has-hover ? DesignTokens.surface-hover : transparent;

    HorizontalLayout {
        padding-left: DesignTokens.space-3;
        padding-right: DesignTokens.space-3;
        spacing: DesignTokens.space-3;
        VerticalLayout {
            spacing: 1px;
            Text { text: root.label; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
            if root.description != "" : Text { text: root.description; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center; }
        }
        SettingSwitch { active: root.active; toggled => { root.toggled(); } }
    }
    toggle-touch := TouchArea { enabled: false; }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: DesignTokens.radius-medium;
    background: root.active ? DesignTokens.accent-muted : nav-touch.has-hover && root.enabled ? DesignTokens.surface-hover : transparent;

    if root.active : Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: DesignTokens.accent;
    }

    HorizontalLayout {
        padding-left: 42px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        IconSlot {
            width: 19px;
            name: root.icon;
            icon-size: 19px;
            icon-color: !root.enabled ? DesignTokens.text-disabled : root.active ? DesignTokens.accent : DesignTokens.text-secondary;
        }
        Text {
            width: 112px;
            text: root.label;
            color: !root.enabled ? DesignTokens.text-disabled : root.active ? DesignTokens.accent : DesignTokens.text-primary;
            font-size: 13px;
            font-weight: root.active ? DesignTokens.weight-section-title : DesignTokens.weight-body;
            vertical-alignment: center;
        }
    }

    nav-touch := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component SettingsGroupLabel inherits Rectangle {
    in property <string> label;
    in property <bool> dark: false;

    height: 28px;
    background: transparent;

    Text {
        x: 2px;
        width: parent.width - 4px;
        text: root.label;
        color: DesignTokens.text-muted;
        font-size: DesignTokens.type-caption;
        font-weight: DesignTokens.weight-item-title;
        vertical-alignment: center;
    }
}

component SettingsPageItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> dark: false;
    callback clicked();

    height: 36px;
    border-radius: DesignTokens.radius-medium;
    background: root.active
        ? DesignTokens.accent-muted
        : page-touch.has-hover ? DesignTokens.surface-hover : transparent;

    if root.active : Rectangle {
        x: 0px;
        y: 4px;
        width: 3px;
        height: parent.height - 8px;
        border-radius: 2px;
        background: DesignTokens.accent;
    }

    Text {
        x: 13px;
        width: parent.width - 23px;
        text: root.label;
        color: root.active ? DesignTokens.accent : DesignTokens.text-secondary;
        font-size: DesignTokens.type-item-title;
        font-weight: root.active ? DesignTokens.weight-section-title : DesignTokens.weight-body;
        vertical-alignment: center;
    }

    page-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component SettingsSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description: "";

    height: root.description == "" ? 30px : 48px;
    background: transparent;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.title;
            color: DesignTokens.text-primary;
            font-size: DesignTokens.type-section-title;
            font-weight: DesignTokens.weight-section-title;
            vertical-alignment: center;
        }
        if root.description != "" : Text {
            text: root.description;
            color: DesignTokens.text-muted;
            font-size: DesignTokens.type-secondary;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

component SettingsSeparator inherits Rectangle {
    height: 1px;
    background: DesignTokens.border-subtle;
}

component SegmentedSettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> first-text;
    in property <string> second-text;
    in property <string> third-text: "";
    in property <int> selected-index: 0;
    callback selected(int);

    height: root.description == "" ? 48px : 58px;
    border-radius: DesignTokens.radius-small;
    background: segment-row-touch.has-hover ? DesignTokens.surface-hover : transparent;
    segment-row-touch := TouchArea { enabled: false; }

    HorizontalLayout {
        padding-left: DesignTokens.space-3;
        padding-right: DesignTokens.space-2;
        spacing: DesignTokens.space-3;
        VerticalLayout {
            min-width: 156px;
            vertical-stretch: 1;
            spacing: 2px;
            Text { text: root.label; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
            if root.description != "" : Text { text: root.description; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center; }
        }
        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
        SettingValueButton { width: 82px; height: 30px; text: root.first-text; selected: root.selected-index == 0; clicked => { root.selected(0); } }
        SettingValueButton { width: 82px; height: 30px; text: root.second-text; selected: root.selected-index == 1; clicked => { root.selected(1); } }
        if root.third-text != "" : SettingValueButton { width: 82px; height: 30px; text: root.third-text; selected: root.selected-index == 2; clicked => { root.selected(2); } }
    }
}

component WorkspaceGroupRow inherits Rectangle {
    in property <LibraryShelf> shelf;
    in property <bool> active;
    in property <int> shelf-index;
    in property <int> maximum-drag-index;
    in property <bool> drag-source-active;
    in property <bool> drag-target-active;
    in property <bool> drop-after;
    in-out property <length> drag-start-y: 0px;
    in-out property <int> drag-target-index: root.shelf-index;
    in-out property <bool> dragging: false;
    callback selected();
    callback reorder(int);
    callback drag-state(string, string, int, int, bool);
    callback delete-requested(string, string);

    height: 36px;
    border-radius: 8px;
    border-width: root.drag-source-active ? 1px : 0px;
    border-color: DesignTokens.accent-border;
    background: root.drag-target-active ? DesignTokens.accent-muted : root.drag-source-active ? DesignTokens.surface-active : root.active ? DesignTokens.accent-muted : row-touch.has-hover ? DesignTokens.surface-hover : transparent;

    row-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.shelf.name;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: 7px;
        spacing: 7px;
        if root.shelf.id == "ungrouped" : Text {
            width: 12px;
            text: "•";
            color: root.active ? DesignTokens.accent : DesignTokens.text-disabled;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.shelf.id != "ungrouped" : Rectangle {
            width: 12px;
            Text {
                text: "≡";
                color: root.drag-source-active ? DesignTokens.accent : root.active ? DesignTokens.accent : DesignTokens.text-muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            drag-handle := TouchArea {
                accessible-role: button;
                accessible-label: "拖动调整分组顺序";
                mouse-cursor: move;
                moved => {
                    if (self.pressed) {
                        root.drag-target-index = Math.max(2, Math.min(root.maximum-drag-index, root.shelf-index + Math.round((self.mouse-y - root.drag-start-y) / 36px)));
                        root.dragging = root.drag-target-index != root.shelf-index;
                        root.drag-state(root.shelf.id, root.shelf.name, root.shelf-index, root.drag-target-index, true);
                    }
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-start-y = self.mouse-y;
                        root.drag-target-index = root.shelf-index;
                        root.dragging = false;
                        root.drag-state(root.shelf.id, root.shelf.name, root.shelf-index, root.shelf-index, true);
                    } else if (event.kind == PointerEventKind.up) {
                        if (root.dragging) {
                            root.reorder(root.drag-target-index - 2);
                        }
                        root.dragging = false;
                        root.drag-state("", "", 0, 0, false);
                    } else if (event.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                        root.drag-state("", "", 0, 0, false);
                    }
                }
            }
        }
        Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: root.shelf.name; color: root.active ? DesignTokens.accent : DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: root.active ? 680 : DesignTokens.weight-body; overflow: elide; vertical-alignment: center; }
        Text { width: 24px; text: root.shelf.count; color: root.active ? DesignTokens.accent : DesignTokens.text-muted; font-size: DesignTokens.type-caption; font-weight: 620; horizontal-alignment: right; vertical-alignment: center; }
        if root.shelf.id != "ungrouped" : Rectangle {
            width: 22px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                border-radius: 5px;
                background: delete-group-touch.has-hover ? #feeceb : transparent;
            }
            Text { text: "×"; color: delete-group-touch.has-hover ? DesignTokens.danger : DesignTokens.text-disabled; font-size: 14px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
            delete-group-touch := TouchArea {
                accessible-role: button;
                accessible-label: "删除分组" + root.shelf.name;
                mouse-cursor: pointer;
                clicked => { root.delete-requested(root.shelf.id, root.shelf.name); }
            }
        }
    }

    if root.drag-target-active : Rectangle {
        x: 20px;
        y: root.drop-after ? root.height - 3px : 0px;
        width: root.width - 28px;
        height: 3px;
        border-radius: 2px;
        background: DesignTokens.accent;
        Rectangle {
            x: -3px;
            y: -2px;
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: DesignTokens.accent;
        }
    }
}

component PopupChoiceRow inherits Rectangle {
    in property <string> text;
    in property <string> detail: "";
    in property <bool> active: false;
    callback selected();

    height: 40px;
    border-radius: DesignTokens.radius-medium;
    background: root.active ? DesignTokens.accent-muted : choice-touch.has-hover ? DesignTokens.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 8px;
        Text { width: 13px; text: root.active ? "✓" : ""; color: DesignTokens.accent; font-size: DesignTokens.type-body; font-weight: 750; vertical-alignment: center; }
        Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: root.text; color: root.active ? DesignTokens.accent : DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: root.active ? 680 : DesignTokens.weight-body; overflow: elide; vertical-alignment: center; }
        Text { width: root.detail == "" ? 0px : 40px; text: root.detail; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
    }
    choice-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.text;
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

component ShortcutSettingRow inherits Rectangle {
    in property <string> action;
    in property <string> label;
    in property <string> value;
    in property <bool> capturing: false;
    callback capture(string);
    callback clear(string);

    height: 52px;
    border-color: DesignTokens.border-subtle;
    border-width: 0px;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: DesignTokens.border-subtle; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 10px;
        Text { min-width: 108px; preferred-width: 108px; text: root.label; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
        Rectangle {
            width: 132px;
            height: 34px;
            border-radius: DesignTokens.radius-medium;
            border-width: root.capturing ? 2px : 1px;
            border-color: root.capturing ? DesignTokens.focus : DesignTokens.border;
            background: root.capturing ? DesignTokens.accent-muted : capture-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
            Text {
                text: root.capturing ? "请按下组合键…" : root.value == "" ? "无" : root.value;
                color: root.capturing ? DesignTokens.accent : root.value == "" ? DesignTokens.text-disabled : DesignTokens.text-secondary;
                font-size: DesignTokens.type-secondary;
                font-weight: 620;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            capture-touch := TouchArea {
                accessible-role: button;
                accessible-label: root.label + "快捷键";
                mouse-cursor: pointer;
                clicked => { root.capture(root.action); }
            }
        }
        SettingValueButton {
            width: 46px;
            height: 32px;
            text: "清除";
            clicked => { root.clear(root.action); }
        }
    }
}

component NavigationPane inherits Rectangle {
    in property <bool> reader-open;
    in property <bool> settings-open;
    in property <[LibraryShelf]> shelves;
    in property <string> selected-group-id: "all";
    in-out property <bool> groups-expanded: false;
    in-out property <string> dragging-group-id: "";
    in-out property <int> drag-source-index: 0;
    in-out property <int> drag-target-index: 0;
    callback show-library();
    callback show-reader();
    callback show-settings();
    callback open-file();
    callback select-group(string, string, int);
    callback reorder-group(string, int);
    callback delete-group(string, string);

    width: 220px;
    background: DesignTokens.surface-subtle;
    border-color: DesignTokens.border-subtle;
    border-width: 0px;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 66px;
            border-color: DesignTokens.border-subtle;
            border-width: 0px;
            if !root.reader-open : ActionButton {
                x: 10px;
                y: 11px;
                width: parent.width - 20px;
                height: 42px;
                text: "打开文件";
                primary: true;
                clicked => { root.open-file(); }
            }
            if root.reader-open : ActionButton {
                x: 10px;
                y: 11px;
                width: parent.width - 20px;
                height: 42px;
                text: "打开文件";
                primary: true;
                clicked => { root.open-file(); }
            }
        }

        Rectangle {
            height: 1px;
            background: DesignTokens.border-subtle;
        }

        Rectangle {
            min-height: 0px;
            preferred-height: 0px;
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 22px;
                spacing: 4px;

                Text {
                    height: 25px;
                    text: "工作区";
                    color: DesignTokens.text-muted;
                    font-size: 11px;
                    font-weight: 650;
                    vertical-alignment: center;
                }
                NavItem {
                    label: "书库";
                    icon: "library";
                    active: !root.reader-open && !root.settings-open;
                    clicked => { root.show-library(); }
                }
                for shelf[index] in root.shelves : WorkspaceGroupRow {
                    visible: index == 1 || (index >= 2 && (index < 7 || root.groups-expanded));
                    height: self.visible ? 36px : 0px;
                    shelf: shelf;
                    shelf-index: index;
                    maximum-drag-index: root.groups-expanded ? root.shelves.length - 1 : Math.min(6, root.shelves.length - 1);
                    active: root.selected-group-id == shelf.id && !root.reader-open && !root.settings-open;
                    drag-source-active: root.dragging-group-id == shelf.id;
                    drag-target-active: root.dragging-group-id != "" && root.drag-target-index == index && root.drag-source-index != index;
                    drop-after: root.drag-target-index > root.drag-source-index;
                    selected => { root.select-group(shelf.id, shelf.name, index); }
                    reorder(target-index) => { root.reorder-group(shelf.id, target-index); }
                    drag-state(id, name, source-index, target-index, active) => {
                        root.dragging-group-id = active ? id : "";
                        root.drag-source-index = source-index;
                        root.drag-target-index = target-index;
                    }
                    delete-requested(id, name) => { root.delete-group(id, name); }
                }
                if root.shelves.length > 7 : SettingValueButton {
                    height: 28px;
                    text: root.groups-expanded ? "收起分组" : "展开更多（" + (root.shelves.length - 7) + "）";
                    clicked => { root.groups-expanded = !root.groups-expanded; }
                }
                NavItem {
                    label: "阅读与编辑";
                    icon: "document";
                    active: root.reader-open && !root.settings-open;
                    clicked => { root.show-reader(); }
                }
                NavItem {
                    label: "设置";
                    icon: "settings";
                    active: root.settings-open;
                    clicked => { root.show-settings(); }
                }
            }
        }

    }
}

component BookCard inherits Rectangle {
    in property <LibraryBook> book;
    callback open(string);
    callback remove(string, string);
    callback choose-group(string, string);

    height: 430px;
    min-width: 188px;
    preferred-width: 248px;
    max-width: 280px;
    border-radius: 12px;
    border-width: 1px;
    border-color: card-touch.has-hover && root.book.available ? DesignTokens.accent-border : DesignTokens.border-subtle;
    background: card-touch.has-hover && root.book.available ? DesignTokens.surface : DesignTokens.surface-subtle;

    card-touch := TouchArea {
        enabled: root.book.available;
        accessible-role: list-item;
        accessible-label: root.book.title;
        clicked => { root.open(root.book.path); }
    }

    VerticalLayout {
        padding: 13px;
        spacing: 8px;

        Rectangle {
            height: 220px;
            background: transparent;
            if root.book.has-cover : Image {
                x: (parent.width - self.width) / 2;
                width: 146px;
                height: 220px;
                source: root.book.cover;
                image-fit: cover;
            }
            if !root.book.has-cover : Rectangle {
                x: (parent.width - self.width) / 2;
                width: 146px;
                height: 220px;
                border-radius: 5px;
                background: root.book.kind == "EPUB"
                    ? @linear-gradient(145deg, #315fc4, #173b83)
                    : @linear-gradient(145deg, #343941, #111318);
                border-color: #272b31;
                border-width: 1px;

                Rectangle {
                    x: 5px;
                    width: 2px;
                    height: parent.height;
                    background: #ffffff18;
                }
                Text {
                    x: 13px;
                    y: 13px;
                    text: root.book.kind;
                    color: #ffffffb8;
                    font-family: "Cascadia Mono";
                    font-size: 8px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                Text {
                    x: 14px;
                    y: 48px;
                    width: parent.width - 28px;
                    height: 116px;
                    text: root.book.title;
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: 720;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Text {
                    x: 14px;
                    y: parent.height - 27px;
                    text: "READLOOM";
                    color: #ffffff9a;
                    font-family: "Cascadia Mono";
                    font-size: 7px;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                }
            }
        }

        Text {
            height: 15px;
            text: (root.book.kind == "EPUB" ? "电子书" : "文本书籍") + " · " + root.book.group-name;
            color: root.book.available ? DesignTokens.accent : DesignTokens.danger;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            height: 24px;
            text: root.book.title;
            color: root.book.available ? DesignTokens.text-primary : DesignTokens.text-disabled;
            font-size: 15px;
            font-weight: 670;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            height: 17px;
            text: root.book.available ? root.book.subtitle : "文件已移动或删除";
            color: DesignTokens.text-muted;
            font-size: 10px;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
        ActionButton {
            height: 34px;
            text: root.book.available ? "打开" : "不可用";
            primary: true;
            enabled: root.book.available;
            clicked => { root.open(root.book.path); }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 7px;
            ActionButton {
                text: "换分组";
                clicked => { root.choose-group(root.book.path, root.book.title); }
            }
            ActionButton {
                text: "移除";
                clicked => { root.remove(root.book.path, root.book.title); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Readloom 阅织";
    icon: @image-url("../crates/readloom-slint/assets/app-icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 640px;
    background: DesignTokens.surface;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    changed width => { root.request-geometry-measurement(); }

    in property <[LibraryBookRow]> library-book-rows;
    in property <int> library-book-count: 0;
    in property <[LibraryShelf]> library-shelves;
    in property <[LibraryShelf]> library-group-targets;
    in property <[LibraryShelf]> library-group-filter-options;
    in property <[ChapterItem]> chapters;
    in property <[ParagraphItem]> paragraphs;
    in property <[ParagraphRow]> paragraph-rows;
    in property <[SearchItem]> search-results;
    in-out property <bool> search-results-truncated: false;
    in property <[BookmarkItem]> bookmarks;
    in property <[OpenDocumentTab]> open-document-tabs;
    in-out property <bool> reader-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> remove-confirm-open: false;
    in-out property <string> remove-confirm-path: "";
    in-out property <string> remove-confirm-title: "";
    in-out property <bool> delete-group-confirm-open: false;
    in-out property <string> delete-group-confirm-id: "";
    in-out property <string> delete-group-confirm-name: "";
    in-out property <bool> group-picker-open: false;
    in-out property <string> group-picker-path: "";
    in-out property <string> group-picker-title: "";
    in-out property <bool> dirty-confirm-open: false;
    in-out property <string> dirty-confirm-action: "";
    in-out property <string> dirty-confirm-path: "";
    in-out property <string> dirty-confirm-title: "";
    in-out property <bool> save-conflict-open: false;
    in-out property <string> save-conflict-message: "";
    in-out property <string> library-search-query: "";
    in-out property <string> library-type-filter: "all";
    in-out property <string> library-group-filter: "all";
    in-out property <string> library-group-label: "全部图书";
    in-out property <int> library-group-filter-index: 0;
    in-out property <string> library-group-search-query: "";
    in-out property <string> library-sort-mode: "recent";
    in-out property <bool> workspace-groups-expanded: false;
    in-out property <string> document-title: "";
    in-out property <string> document-path: "";
    in-out property <string> document-author: "";
    in-out property <string> document-kind: "TXT";
    in-out property <bool> edit-mode: false;
    in-out property <bool> edit-dirty: false;
    in-out property <bool> edit-can-undo: false;
    in-out property <bool> edit-can-redo: false;
    in-out property <string> edit-anchor-block-id: "";
    in-out property <int> edit-caret-utf16: 0;
    in-out property <int> edit-caret-byte: 0;
    in-out property <int> edit-restore-generation: 0;
    in-out property <float> edit-anchor-pixel-offset: 0;
    in-out property <bool> view-anchor-restore-pending: false;
    in-out property <int> geometry-measure-generation: 0;
    in-out property <string> document-encoding: "UTF-8";
    in-out property <string> document-line-ending: "LF";
    in-out property <string> status-text: "正在连接本地书库…";
    in-out property <length> workspace-pane-width: 220px;
    in-out property <length> reader-tools-pane-width: 240px;
    in-out property <length> settings-navigation-width: 228px;
    in-out property <length> epub-search-panel-width: 260px;
    in-out property <bool> pane-resize-preview-active: false;
    in-out property <string> pane-resize-preview-kind: "";
    in-out property <float> pane-resize-preview-width: 0;
    in-out property <length> pane-resize-preview-x: 0px;
    in-out property <string> reader-side-panel: "";
    in-out property <bool> new-group-form-open: false;
    in-out property <string> new-group-name: "";
    in-out property <int> active-paragraph-index: 0;
    in-out property <int> active-chapter-index: 0;
    in-out property <string> active-chapter-title: "";
    in-out property <int> document-paragraph-count: 0;
    in-out property <int> reader-window-start: 0;
    in-out property <int> reader-target-row: 0;
    in-out property <length> reader-viewport-y: 0px;
    in-out property <string> settings-section: "reading.typography";
    in-out property <string> settings-theme: "light";
    in-out property <string> settings-effective-theme: "light";
    in-out property <int> settings-library-columns: 4;
    in-out property <float> settings-background-opacity: 0.2;
    in-out property <image> settings-background-image;
    in-out property <bool> settings-has-background: false;
    in-out property <bool> settings-minimize-to-tray: false;
    in-out property <string> settings-close-action: "exit";
    in-out property <string> settings-font-id: "source-han-serif";
    in-out property <string> settings-font-family: "Microsoft YaHei UI";
    in-out property <bool> settings-font-fallback: false;
    in-out property <int> settings-font-size: 19;
    in-out property <int> settings-font-weight: 400;
    in-out property <float> settings-letter-spacing: 0;
    in-out property <float> settings-first-line-indent: 2;
    in-out property <string> settings-indent-prefix: "　　";
    in-out property <float> settings-line-height: 1.7;
    in-out property <float> settings-paragraph-spacing: 0.15;
    in-out property <int> settings-content-width: 780;
    in-out property <int> settings-horizontal-margin: 40;
    in-out property <int> settings-vertical-margin: 30;
    in-out property <string> settings-text-alignment: "justify";
    in-out property <int> settings-reading-columns: 1;
    in-out property <string> settings-txt-leading-indent: "clean";
    in-out property <string> settings-txt-blank-lines: "single";
    in-out property <bool> settings-merge-wrapped-lines: false;
    in-out property <string> settings-chapter-title-style: "prominent";
    in-out property <bool> settings-epub-publisher-styles: true;
    in-out property <bool> settings-epub-override-font: false;
    in-out property <bool> settings-epub-override-font-size: true;
    in-out property <bool> settings-epub-override-indent: false;
    in-out property <bool> settings-epub-override-line-height: true;
    in-out property <bool> settings-epub-override-paragraph-spacing: false;
    in-out property <bool> settings-epub-embedded-fonts: true;
    in-out property <string> settings-chapter-pattern: "";
    in-out property <string> settings-pattern-error: "";
    in-out property <string> settings-backup-path: "";
    in-out property <string> settings-backup-result: "";
    in-out property <string> shortcut-open: "";
    in-out property <string> shortcut-save: "";
    in-out property <string> shortcut-save-as: "";
    in-out property <string> shortcut-close: "";
    in-out property <string> shortcut-toggle-edit: "";
    in-out property <string> shortcut-previous-chapter: "";
    in-out property <string> shortcut-next-chapter: "";
    in-out property <string> shortcut-bookmark: "";
    in-out property <string> shortcut-show-library: "";
    in-out property <string> shortcut-show-settings: "";
    in-out property <string> shortcut-capture-action: "";

    callback open-document(string);
    callback open-file();
    callback refresh-library();
    callback remove-library-book(string, string);
    callback create-library-group(string);
    callback delete-library-group(string);
    callback import-library-files();
    callback import-library-directory();
    callback clean-invalid-library-books();
    callback refresh-library-view();
    callback move-library-book(string, string, string);
    callback reorder-library-group(string, int);
    callback filter-library-groups(string);
    callback show-open-documents();
    callback select-open-document(string);
    callback close-open-document(string);
    callback delete-bookmark(string);
    callback back-to-library();
    callback search-text(string);
    callback reading-position-changed(int);
    callback request-reader-window(int);
    callback navigate-exact(int);
    callback reader-viewport-changed(float);
    callback open-epub-location(int, int);
    callback preview-pane-resize(string, float);
    callback commit-pane-resize(string, float);
    callback previous-chapter();
    callback next-chapter();
    callback add-bookmark();
    callback request-edit-mode(bool);
    callback replace-block-text(string, string, int);
    callback join-adjacent-text(string, string, string, int, int) -> bool;
    callback report-block-geometry(string, float, float);
    callback request-geometry-measurement();
    callback capture-view-anchor(string, int, float);
    callback save-document();
    callback save-document-as();
    callback undo-edit();
    callback redo-edit();
    callback insert-epub-image();
    callback remove-epub-image(string);
    callback set-epub-image-alt(string, string);
    callback resolve-dirty-decision(string);
    callback resolve-save-conflict(string);
    callback update-setting(string, string);
    callback change-setting(string, float);
    callback choose-background();
    callback clear-background();
    callback set-shortcut(string, string);
    callback begin-shortcut-capture(string);
    callback clear-shortcuts();
    callback set-chapter-pattern(string);
    callback reset-chapter-pattern();
    callback choose-backup-path();
    callback create-backup();
    callback restore-backup();
    callback restore-backup-directory();

    public function navigate-to(index: int) {
        let target = root.document-paragraph-count > 0
            ? Math.max(0, Math.min(index, root.document-paragraph-count - 1))
            : Math.max(0, index);
        root.request-reader-window(target);
        root.active-paragraph-index = target;
        root.navigate-exact(target);
        root.reading-position-changed(target);
    }

    function show-library() {
        root.settings-open = false;
        if (root.reader-open) {
            root.back-to-library();
        }
    }

    function show-reader() {
        root.settings-open = false;
        root.show-open-documents();
    }

    function show-settings() {
        if (root.edit-dirty) {
            root.dirty-confirm-action = "settings";
            root.dirty-confirm-path = root.document-path;
            root.dirty-confirm-title = root.document-title;
            root.dirty-confirm-open = true;
        } else {
            root.settings-open = true;
            root.status-text = "设置会立即保存到本地数据库。";
        }
    }

    function open-file-hint() {
        root.open-file();
    }

    preview-pane-resize(pane, width) => {
        root.pane-resize-preview-active = true;
        root.pane-resize-preview-kind = pane;
        root.pane-resize-preview-width = width;
        root.pane-resize-preview-x = pane == "workspace"
            ? width * 1px
            : pane == "reader-side"
                ? root.width - width * 1px - 6px
                : root.workspace-pane-width + 8px + width * 1px;
    }

    commit-pane-resize(pane, width) => {
        if (pane == "workspace") {
            root.workspace-pane-width = width * 1px;
        } else if (pane == "reader-tools") {
            root.reader-tools-pane-width = width * 1px;
        } else if (pane == "reader-side") {
            root.epub-search-panel-width = width * 1px;
        } else if (pane == "settings-navigation") {
            root.settings-navigation-width = width * 1px;
        }
        root.pane-resize-preview-active = false;
        root.pane-resize-preview-kind = "";
    }

    function request-remove-book(path: string, title: string) {
        root.remove-confirm-path = path;
        root.remove-confirm-title = title;
        root.remove-confirm-open = true;
    }

    function request-group-picker(path: string, title: string) {
        root.group-picker-path = path;
        root.group-picker-title = title;
        root.group-picker-open = true;
    }

    changed reader-viewport-y => {
        if (root.reader-open) {
            root.reader-viewport-changed(root.reader-viewport-y / 1px);
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: DesignTokens.surface;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 48px;
            background: DesignTokens.surface-subtle;
            border-color: DesignTokens.border-subtle;
            border-width: 0px;

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: root.workspace-pane-width;
                    background: DesignTokens.surface-subtle;
                    border-color: DesignTokens.border-subtle;
                    border-width: 0px;
                    if !root.reader-open : BrandContent { }
                    if root.reader-open : BrandContent { }
                }

                Rectangle {
                    width: root.settings-open ? 182px : root.reader-open ? 330px : 182px;
                    background: DesignTokens.surface;
                    border-color: DesignTokens.border-subtle;
                    border-width: 0px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;
                        IconSlot {
                            width: 16px;
                            name: root.settings-open ? "settings" : root.reader-open ? "document" : "library";
                            icon-size: 16px;
                            icon-color: DesignTokens.accent;
                        }
                        if root.reader-open && !root.settings-open : Text {
                            width: 24px;
                            text: root.document-kind;
                            color: DesignTokens.text-disabled;
                            font-family: "Cascadia Mono";
                            font-size: 8px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.settings-open ? "设置" : root.reader-open ? root.document-title : "我的书库";
                            color: DesignTokens.accent;
                            font-size: 13px;
                            font-weight: 650;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.reader-open && !root.settings-open : Rectangle {
                            width: 24px;
                            close-tab-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "关闭文档";
                                clicked => { root.back-to-library(); }
                            }
                            Rectangle {
                                y: (parent.height - 24px) / 2;
                                width: 24px;
                                height: 24px;
                                border-radius: DesignTokens.radius-small;
                                background: close-tab-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                Text {
                                    text: "×";
                                    color: DesignTokens.text-muted;
                                    font-size: 17px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 2px;
                        width: parent.width;
                        height: 2px;
                        background: DesignTokens.accent;
                    }
                }

                Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: DesignTokens.surface-subtle; }

                Rectangle {
                    width: 92px;
                    background: settings-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-subtle;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 7px;
                        alignment: center;
                        IconSlot {
                            width: 17px;
                            name: "settings";
                            icon-size: 17px;
                        }
                        Text {
                            text: "设置";
                            color: DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }
                    settings-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "设置";
                        clicked => { root.show-settings(); }
                    }
                }

                Rectangle {
                    width: 132px;
                    background: DesignTokens.surface-subtle;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 7px;
                        alignment: center;
                        StatusDotSlot {
                            width: 7px;
                        }
                        Text {
                            text: "Rust 已连接";
                            color: DesignTokens.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: DesignTokens.border-subtle;
            }
        }

        Rectangle {
            x: 0px;
            y: 48px;
            width: parent.width;
            height: parent.height - 75px;
            background: DesignTokens.surface;

            NavigationPane {
                x: 0px;
                y: 0px;
                width: root.workspace-pane-width;
                height: parent.height;
                reader-open: root.reader-open;
                settings-open: root.settings-open;
                shelves: root.library-shelves;
                selected-group-id: root.library-group-filter;
                groups-expanded <=> root.workspace-groups-expanded;
                show-library => { root.show-library(); }
                show-reader => { root.show-reader(); }
                show-settings => { root.show-settings(); }
                open-file => { root.open-file-hint(); }
                select-group(id, name, index) => {
                    root.library-group-filter = id;
                    root.library-group-label = name;
                    root.library-group-filter-index = index;
                    root.show-library();
                    root.refresh-library-view();
                }
                reorder-group(id, target-index) => { root.reorder-library-group(id, target-index); }
                delete-group(id, name) => {
                    root.delete-group-confirm-id = id;
                    root.delete-group-confirm-name = name;
                    root.delete-group-confirm-open = true;
                }
            }

            Rectangle {
                x: root.workspace-pane-width;
                y: 0px;
                width: 8px;
                height: parent.height;
                background: DesignTokens.surface-subtle;
                workspace-resize := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.preview-pane-resize("workspace", Math.max(168px, Math.min(360px, self.absolute-position.x + self.mouse-x)) / 1px);
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && root.pane-resize-preview-kind == "workspace") {
                            root.commit-pane-resize("workspace", root.pane-resize-preview-width);
                        } else if (event.kind == PointerEventKind.cancel && root.pane-resize-preview-kind == "workspace") {
                            root.pane-resize-preview-active = false;
                            root.pane-resize-preview-kind = "";
                        }
                    }
                }
            }

            if !root.reader-open && !root.settings-open : Rectangle {
                x: root.workspace-pane-width + 8px;
                y: 0px;
                width: parent.width - root.workspace-pane-width - 8px;
                height: parent.height;
                background: DesignTokens.surface;

                VerticalLayout {
                    x: parent.width > 1240px ? (parent.width - 1240px) / 2 : 0px;
                    width: Math.min(parent.width, 1240px);
                    height: parent.height;
                    padding-left: 30px;
                    padding-right: 30px;
                    padding-top: 28px;
                    padding-bottom: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 68px;
                        spacing: 18px;
                        VerticalLayout {
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: "我的书库";
                                color: DesignTokens.text-primary;
                                font-size: 28px;
                                font-weight: DesignTokens.weight-page-title;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "整理本机 EPUB 与文本书籍，打开记录与书库收藏彼此独立。";
                                color: DesignTokens.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        ActionButton { width: 60px; text: "刷新"; clicked => { root.refresh-library(); } }
                        ActionButton { width: 78px; text: "新建分组"; clicked => { root.new-group-form-open = !root.new-group-form-open; } }
                        ActionButton { width: 78px; text: "导入目录"; clicked => { root.import-library-directory(); } }
                        ActionButton {
                            width: 78px;
                            text: "导入图书";
                            primary: true;
                            clicked => { root.import-library-files(); }
                        }
                        ActionButton { width: 88px; text: "清理无效"; clicked => { root.clean-invalid-library-books(); } }
                    }

                    if root.new-group-form-open : Rectangle {
                        height: 58px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: DesignTokens.accent-border;
                        background: DesignTokens.accent-muted;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            Text { width: 76px; text: "分组名称"; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                            LineEdit { text <=> root.new-group-name; placeholder-text: "例如：小说书架"; accepted(text) => { if (text != "") { root.create-library-group(text); root.new-group-name = ""; root.new-group-form-open = false; } } }
                            ActionButton { width: 72px; text: "创建"; primary: true; enabled: root.new-group-name != ""; clicked => { root.create-library-group(root.new-group-name); root.new-group-name = ""; root.new-group-form-open = false; } }
                            ActionButton { width: 64px; text: "取消"; clicked => { root.new-group-name = ""; root.new-group-form-open = false; } }
                        }
                    }

                    Rectangle {
                        height: 82px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: DesignTokens.border-subtle;
                        background: DesignTokens.surface-subtle;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;
                            VerticalLayout {
                                min-width: 0px;
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text {
                                    height: 14px;
                                    text: "搜索书库";
                                    color: DesignTokens.text-muted;
                                    font-size: 9px;
                                    font-weight: 650;
                                }
                                LineEdit {
                                    accessible-id: "library-search";
                                    placeholder-text: "书名、作者或路径";
                                    text <=> root.library-search-query;
                                    edited(text) => {
                                        root.library-search-query = text;
                                        root.refresh-library-view();
                                    }
                                }
                            }
                            Rectangle {
                                width: 252px;
                                background: transparent;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        height: 14px;
                                        text: "类型";
                                        color: DesignTokens.text-muted;
                                        font-size: 9px;
                                        font-weight: 650;
                                    }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 7px;
                                        background: DesignTokens.surface-active;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 2px;
                                            SettingValueButton { width: 50px; height: 30px; text: "全部"; selected: root.library-type-filter == "all"; clicked => { root.library-type-filter = "all"; root.refresh-library-view(); } }
                                            SettingValueButton { width: 58px; height: 30px; text: "EPUB"; selected: root.library-type-filter == "epub"; clicked => { root.library-type-filter = "epub"; root.refresh-library-view(); } }
                                            SettingValueButton { width: 50px; height: 30px; text: "TXT"; selected: root.library-type-filter == "txt"; clicked => { root.library-type-filter = "txt"; root.refresh-library-view(); } }
                                            SettingValueButton { width: 70px; height: 30px; text: "已移动"; selected: root.library-type-filter == "missing"; clicked => { root.library-type-filter = "missing"; root.refresh-library-view(); } }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 156px;
                                background: transparent;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text { height: 14px; text: "分组"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; font-weight: DesignTokens.weight-item-title; }
                                    group-filter-button := Rectangle {
                                        height: 36px;
                                        border-radius: DesignTokens.radius-small;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        background: DesignTokens.surface;
                                        Text { x: 10px; width: parent.width - 28px; text: root.library-group-label; color: DesignTokens.text-secondary; font-size: DesignTokens.type-secondary; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
                                        Text { x: parent.width - 20px; width: 12px; text: "▼"; color: DesignTokens.text-muted; font-size: 7px; vertical-alignment: center; }
                                        TouchArea {
                                            accessible-role: button;
                                            accessible-label: "展开书库分组列表";
                                            clicked => {
                                                root.library-group-search-query = "";
                                                root.filter-library-groups("");
                                                group-filter-popup.show();
                                            }
                                        }
                                        group-filter-popup := PopupWindow {
                                            x: 0px;
                                            y: parent.height + 5px;
                                            width: 238px;
                                            height: Math.min(330px, 64px + root.library-group-filter-options.length * 40px);
                                            close-policy: close-on-click-outside;
                                            Rectangle {
                                                border-radius: DesignTokens.radius-medium;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                background: DesignTokens.surface;
                                                drop-shadow-blur: 10px;
                                                drop-shadow-color: #17203324;
                                                drop-shadow-offset-y: 4px;
                                                VerticalLayout {
                                                    padding: 7px;
                                                    spacing: 5px;
                                                    LineEdit {
                                                        accessible-id: "library-group-filter-search";
                                                        height: 36px;
                                                        text <=> root.library-group-search-query;
                                                        placeholder-text: "搜索分组";
                                                        edited(text) => { root.filter-library-groups(text); }
                                                    }
                                                    ListView {
                                                        accessible-id: "library-group-filter-options";
                                                        min-height: 0px;
                                                        vertical-stretch: 1;
                                                        for shelf[index] in root.library-group-filter-options : PopupChoiceRow {
                                                            text: shelf.name;
                                                            detail: shelf.count;
                                                            active: root.library-group-filter == shelf.id;
                                                            selected => {
                                                                root.library-group-filter = shelf.id;
                                                                root.library-group-label = shelf.name;
                                                                root.library-group-filter-index = index;
                                                                root.refresh-library-view();
                                                                group-filter-popup.close();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 118px;
                                background: transparent;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text { height: 14px; text: "排序"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; font-weight: DesignTokens.weight-item-title; }
                                    sort-button := Rectangle {
                                        height: 36px;
                                        border-radius: DesignTokens.radius-small;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        background: DesignTokens.surface;
                                        Text { x: 10px; width: parent.width - 28px; text: root.library-sort-mode == "title" ? "名称排序" : "最近打开"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-secondary; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
                                        Text { x: parent.width - 20px; width: 12px; text: "▼"; color: DesignTokens.text-muted; font-size: 7px; vertical-alignment: center; }
                                        TouchArea {
                                            accessible-role: button;
                                            accessible-label: "展开书库排序列表";
                                            clicked => { sort-popup.show(); }
                                        }
                                        sort-popup := PopupWindow {
                                            x: 0px;
                                            y: parent.height + 5px;
                                            width: 154px;
                                            height: 94px;
                                            close-policy: close-on-click-outside;
                                            Rectangle {
                                                border-radius: DesignTokens.radius-medium;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                background: DesignTokens.surface;
                                                drop-shadow-blur: 10px;
                                                drop-shadow-color: #17203324;
                                                drop-shadow-offset-y: 4px;
                                                VerticalLayout {
                                                    padding: 7px;
                                                    spacing: 0px;
                                                    PopupChoiceRow {
                                                        text: "最近打开";
                                                        active: root.library-sort-mode == "recent";
                                                        selected => { root.library-sort-mode = "recent"; root.refresh-library-view(); sort-popup.close(); }
                                                    }
                                                    PopupChoiceRow {
                                                        text: "名称排序";
                                                        active: root.library-sort-mode == "title";
                                                        selected => { root.library-sort-mode = "title"; root.refresh-library-view(); sort-popup.close(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 24px;
                        spacing: 5px;
                        Text {
                            width: 20px;
                            text: root.library-book-count;
                            color: DesignTokens.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "本地书籍";
                            color: DesignTokens.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 38px;
                        spacing: 9px;
                        IconSlot {
                            width: 20px;
                            name: "library";
                            icon-size: 20px;
                            icon-color: DesignTokens.accent;
                        }
                        Text {
                            width: 70px;
                            text: root.library-group-label;
                            color: DesignTokens.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 48px;
                            height: 22px;
                            border-radius: 11px;
                            background: DesignTokens.surface-subtle;
                            Text {
                                text: root.library-book-count + " 本";
                                color: DesignTokens.text-muted;
                                font-size: 9px;
                                font-weight: 650;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.library-book-count == 0 : Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        background: DesignTokens.surface-subtle;
                        VerticalLayout {
                            alignment: center;
                            spacing: 9px;
                            Text { text: "R"; color: DesignTokens.accent; font-size: 24px; font-weight: 750; horizontal-alignment: center; }
                            Text { text: root.library-search-query == "" && root.library-type-filter == "all" && root.library-group-filter == "all" ? "书库还是空的" : "没有符合条件的图书"; color: DesignTokens.text-primary; font-size: 18px; font-weight: 680; horizontal-alignment: center; }
                            Text { text: root.library-search-query == "" && root.library-type-filter == "all" && root.library-group-filter == "all" ? "可从上方导入 TXT 或 EPUB 图书。" : "调整搜索、类型或分组筛选后再试。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; horizontal-alignment: center; }
                        }
                    }

                    if root.library-book-count > 0 : ListView {
                        accessible-id: "library-grid";
                        for row in root.library-book-rows : Rectangle {
                            height: 444px;
                            background: transparent;
                            HorizontalLayout {
                                spacing: 14px;
                                BookCard {
                                    book: row.first;
                                    open(path) => { root.open-document(path); }
                                    remove(path, title) => { root.request-remove-book(path, title); }
                                    choose-group(path, title) => { root.request-group-picker(path, title); }
                                }
                                if row.has-second : BookCard {
                                    book: row.second;
                                    open(path) => { root.open-document(path); }
                                    remove(path, title) => { root.request-remove-book(path, title); }
                                    choose-group(path, title) => { root.request-group-picker(path, title); }
                                }
                                if !row.has-second : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                if row.has-third : BookCard {
                                    book: row.third;
                                    open(path) => { root.open-document(path); }
                                    remove(path, title) => { root.request-remove-book(path, title); }
                                    choose-group(path, title) => { root.request-group-picker(path, title); }
                                }
                                if !row.has-third : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                if row.has-fourth : BookCard {
                                    book: row.fourth;
                                    open(path) => { root.open-document(path); }
                                    remove(path, title) => { root.request-remove-book(path, title); }
                                    choose-group(path, title) => { root.request-group-picker(path, title); }
                                }
                                if !row.has-fourth && root.settings-library-columns >= 4 : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                if row.has-fifth : BookCard {
                                    book: row.fifth;
                                    open(path) => { root.open-document(path); }
                                    remove(path, title) => { root.request-remove-book(path, title); }
                                    choose-group(path, title) => { root.request-group-picker(path, title); }
                                }
                                if !row.has-fifth && root.settings-library-columns == 5 : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }
            }

            if root.reader-open && !root.settings-open : Rectangle {
                x: root.workspace-pane-width + 8px;
                y: 0px;
                width: parent.width - root.workspace-pane-width - 8px;
                height: parent.height;
                background: DesignTokens.surface;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                    if root.open-document-tabs.length > 0 : Rectangle {
                        height: 44px;
                        background: DesignTokens.surface-subtle;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 6px;
                            for tab in root.open-document-tabs : DocumentTabButton {
                                tab: tab;
                                selected => { root.select-open-document(tab.path); }
                                closed => { root.close-open-document(tab.path); }
                            }
                            Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        }
                    }

                    if root.document-path == "" : Rectangle {
                        background: DesignTokens.surface;
                        VerticalLayout {
                            alignment: center;
                            spacing: DesignTokens.space-3;
                            Text { text: "尚未打开书籍"; color: DesignTokens.text-primary; font-size: DesignTokens.type-page-title; font-weight: DesignTokens.weight-page-title; horizontal-alignment: center; }
                            Text { text: "前往书库选择 TXT 或 EPUB，已打开的书籍会保留为标签。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-item-title; horizontal-alignment: center; }
                            ActionButton { width: 120px; height: 38px; text: "请打开书籍"; primary: true; clicked => { root.back-to-library(); } }
                        }
                    }

                    if root.document-path != "" : Rectangle {
                        height: 46px;
                        background: DesignTokens.surface;
                        border-color: DesignTokens.border-subtle;
                        border-width: 0px;
                        HorizontalLayout {
                            padding-left: DesignTokens.space-3;
                            padding-right: DesignTokens.space-3;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: DesignTokens.space-1;
                            ToolbarButton { width: 66px; icon: "open"; label: "打开"; clicked => { root.open-file-hint(); } }
                            ToolbarButton {
                                width: 88px;
                                icon: "edit";
                                label: root.edit-mode ? "取消编辑" : "编辑";
                                active: root.edit-mode;
                                clicked => { root.request-edit-mode(!root.edit-mode); }
                            }
                            ToolbarButton {
                                width: 66px;
                                icon: "save";
                                label: "保存";
                                active: root.edit-mode;
                                enabled: root.edit-mode;
                                clicked => { root.save-document(); }
                            }
                            ActionButton {
                                width: 66px;
                                text: "另存为";
                                enabled: root.edit-mode;
                                clicked => { root.save-document-as(); }
                            }
                            ActionButton { width: 58px; text: "撤销"; enabled: root.edit-mode && root.edit-can-undo; clicked => { root.undo-edit(); } }
                            ActionButton { width: 58px; text: "重做"; enabled: root.edit-mode && root.edit-can-redo; clicked => { root.redo-edit(); } }
                            if root.document-kind == "EPUB" && root.edit-mode : ActionButton { width: 88px; text: "插入图片"; clicked => { root.insert-epub-image(); } }
                            ToolbarButton { width: 66px; icon: "search"; label: "搜索"; active: root.reader-side-panel == "search"; clicked => { root.reader-side-panel = "search"; } }
                            ToolbarButton { width: 84px; icon: "bookmark"; label: "书签 " + root.bookmarks.length; active: root.reader-side-panel == "bookmarks"; clicked => { root.reader-side-panel = "bookmarks"; } }
                            ActionButton { width: 58px; text: "关闭"; clicked => { root.close-open-document(root.document-path); } }
                            Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                            if root.document-kind == "TXT" && root.width >= 1366px : Text { width: 48px; text: "保存编码"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                            if root.document-kind == "TXT" && root.width >= 1366px : Rectangle {
                                width: 92px;
                                height: 32px;
                                border-radius: DesignTokens.radius-small;
                                border-width: 1px;
                                border-color: DesignTokens.border-subtle;
                                background: DesignTokens.surface-subtle;
                                Text { text: root.document-encoding; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; font-weight: DesignTokens.weight-item-title; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.document-kind == "TXT" && root.width >= 1500px : Text { width: 40px; text: "换行符"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                            if root.document-kind == "TXT" && root.width >= 1500px : Rectangle {
                                width: 104px;
                                height: 32px;
                                border-radius: DesignTokens.radius-small;
                                border-width: 1px;
                                border-color: DesignTokens.border-subtle;
                                background: DesignTokens.surface-subtle;
                                Text { text: root.document-line-ending; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; font-weight: DesignTokens.weight-item-title; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.document-kind == "TXT" && root.width >= 1500px : ActionButton { width: 78px; text: "按编码重载"; enabled: false; }
                            if root.edit-mode : Text { width: 132px; text: root.edit-dirty ? "有未保存修改" : "已保存"; color: root.edit-dirty ? DesignTokens.accent : DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                            if root.edit-mode && root.width >= 1500px : Text { width: 238px; text: "Enter＝块内换行 · 暂不支持跨段合并"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: DesignTokens.border-subtle; }
                    }

                    if root.document-kind == "EPUB" : Rectangle {
                        height: 44px;
                        background: DesignTokens.surface;
                        HorizontalLayout {
                            padding-left: DesignTokens.space-3;
                            padding-right: DesignTokens.space-3;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: DesignTokens.space-1;
                            IconButton { icon: "previous"; label: "上一章"; clicked => { root.previous-chapter(); } }
                            Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: root.active-chapter-title == "" ? root.document-title : root.active-chapter-title; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
                            Text { width: 76px; text: (root.active-chapter-index + 1) + " / " + root.chapters.length; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            if root.width >= 1366px : Text { width: 88px; text: "已恢复阅读位置"; color: DesignTokens.success; font-size: DesignTokens.type-caption; horizontal-alignment: center; vertical-alignment: center; }
                            ActionButton { width: 48px; text: "前段"; enabled: root.reader-window-start > 0; clicked => { root.navigate-to(Math.max(0, root.reader-window-start - root.paragraphs.length)); } }
                            ActionButton { width: 48px; text: "后段"; enabled: root.reader-window-start + root.paragraphs.length < root.document-paragraph-count; clicked => { root.navigate-to(root.reader-window-start + root.paragraphs.length); } }
                            IconButton { icon: "next"; label: "下一章"; clicked => { root.next-chapter(); } }
                            ToolbarButton { width: 84px; icon: "bookmark"; label: "书签 " + root.bookmarks.length; active: root.reader-side-panel == "bookmarks"; clicked => { root.reader-side-panel = "bookmarks"; } }
                            ToolbarButton { width: 66px; icon: "search"; label: "搜索"; active: root.reader-side-panel == "search"; clicked => { root.reader-side-panel = "search"; } }
                            if root.width >= 1280px : ToolbarButton { width: 82px; icon: "document"; label: "书籍信息"; active: root.reader-side-panel == "info"; clicked => { root.reader-side-panel = "info"; } }
                        }
                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: DesignTokens.border-subtle; }
                    }

                    if root.document-path != "" : HorizontalLayout {
                        spacing: 0px;

                        Rectangle {
                            width: root.reader-tools-pane-width;
                            background: DesignTokens.surface-subtle;
                            border-color: DesignTokens.border-subtle;
                            border-width: 0px;

                            VerticalLayout {
                                padding-left: DesignTokens.space-3;
                                padding-right: DesignTokens.space-3;
                                padding-top: DesignTokens.space-4;
                                padding-bottom: DesignTokens.space-3;
                                spacing: DesignTokens.space-2;

                                Text {
                                    height: 24px;
                                    text: "目录";
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.type-section-title;
                                    font-weight: DesignTokens.weight-section-title;
                                }
                                HorizontalLayout {
                                    height: 27px;
                                    Text { text: root.document-title; color: DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
                                    Text { width: 42px; text: root.chapters.length + " 章"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                                }

                                ListView {
                                    accessible-id: "txt-outline";
                                    vertical-stretch: 1;
                                    for chapter in root.chapters : Rectangle {
                                        height: 36px;
                                        border-radius: DesignTokens.radius-small;
                                        background: chapter.chapter-index == root.active-chapter-index ? DesignTokens.accent-muted : chapter-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                        if chapter.chapter-index == root.active-chapter-index : Rectangle { x: 0px; y: 8px; width: 2px; height: parent.height - 16px; border-radius: 1px; background: DesignTokens.accent; }
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 7px;
                                            Text { width: 24px; text: chapter.line-number; color: DesignTokens.text-muted; font-family: "Cascadia Mono"; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: chapter.title; color: chapter.chapter-index == root.active-chapter-index ? DesignTokens.accent : DesignTokens.text-secondary; font-size: DesignTokens.type-body; font-weight: chapter.chapter-index == root.active-chapter-index ? DesignTokens.weight-item-title : DesignTokens.weight-body; overflow: elide; vertical-alignment: center; }
                                        }
                                        chapter-touch := TouchArea {
                                            accessible-role: list-item;
                                            accessible-label: chapter.title;
                                            clicked => {
                                                if (root.document-kind == "EPUB") {
                                                    root.open-epub-location(chapter.chapter-index, 0);
                                                } else {
                                                    root.navigate-to(chapter.paragraph-index);
                                                }
                                            }
                                        }
                                    }
                                }

                                if false : VerticalLayout {
                                    spacing: 7px;
                                    Rectangle { height: 1px; background: DesignTokens.border-subtle; }
                                    Text { height: 28px; text: "全文搜索"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                    HorizontalLayout {
                                        height: 38px;
                                        spacing: 6px;
                                        search-input := LineEdit { accessible-id: "txt-search-input"; enabled: !root.edit-mode; placeholder-text: "搜索全文"; accepted(text) => { root.search-text(text); } }
                                        ActionButton { width: 48px; text: "搜索"; enabled: !root.edit-mode; clicked => { root.search-text(search-input.text); } }
                                    }
                                    Text { height: 20px; text: root.search-results.length > 0 ? "共 " + (root.search-results-truncated ? "500+" : root.search-results.length) + " 条结果" : "输入关键词并按回车"; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; vertical-alignment: center; }
                                    if root.search-results.length > 0 : ListView {
                                        height: Math.min(180px, root.search-results.length * 68px);
                                        accessible-id: "txt-search-results";
                                        for result[index] in root.search-results : Rectangle {
                                            height: 68px;
                                            border-radius: 6px;
                                            background: result-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                            VerticalLayout { padding: DesignTokens.space-2; spacing: DesignTokens.space-1; Text { height: 18px; text: result.label; color: DesignTokens.accent; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; overflow: elide; } Text { text: result.preview; color: DesignTokens.text-secondary; font-size: 13px; wrap: word-wrap; overflow: elide; } }
                                            result-touch := TouchArea {
                                                accessible-role: list-item;
                                                accessible-label: result.label;
                                                clicked => {
                                                    if (root.document-kind == "EPUB") {
                                                        root.open-epub-location(result.chapter-index, result.paragraph-index);
                                                    } else {
                                                        root.navigate-to(result.paragraph-index);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.search-results.length == 0 : Rectangle { height: 38px; background: transparent; }
                                    Rectangle { height: 1px; background: DesignTokens.border-subtle; }
                                    HorizontalLayout { height: 30px; Text { text: "书签"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; } ActionButton { width: 56px; text: "添加"; enabled: !root.edit-mode; clicked => { root.add-bookmark(); } } }
                                    Text { height: 34px; text: "在当前阅读位置添加书签；书签会持久化到 SQLite。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; wrap: word-wrap; }
                                    Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                                }
                            }
                        }

                        Rectangle {
                            width: 6px;
                            background: transparent;
                            Rectangle { x: (parent.width - 1px) / 2; width: 1px; height: parent.height; background: DesignTokens.border-subtle; }
                            reader-tools-resize := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: col-resize;
                                moved => {
                                    if (self.pressed) {
                                        root.preview-pane-resize("reader-tools", Math.max(180px, Math.min(480px, self.absolute-position.x + self.mouse-x - root.workspace-pane-width - 8px)) / 1px);
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && root.pane-resize-preview-kind == "reader-tools") {
                                        root.commit-pane-resize("reader-tools", root.pane-resize-preview-width);
                                    } else if (event.kind == PointerEventKind.cancel && root.pane-resize-preview-kind == "reader-tools") {
                                        root.pane-resize-preview-active = false;
                                        root.pane-resize-preview-kind = "";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: DesignTokens.reader-background;

                            if root.settings-has-background : Image {
                                source: root.settings-background-image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                                opacity: root.settings-background-opacity;
                            }

                            if root.settings-reading-columns == 1 : reader-list := ScrollView {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                accessible-role: list;
                                accessible-id: "txt-reader-list";
                                viewport-y <=> root.reader-viewport-y;
                                viewport-width: self.width;
                                viewport-height: Math.max(self.height, reader-column.preferred-height);
                                reader-column := VerticalLayout {
                                    width: parent.width;
                                    padding-top: root.settings-vertical-margin * 1px;
                                    padding-bottom: root.settings-vertical-margin * 1px;
                                    for paragraph in root.paragraphs : row := Rectangle {
                                    property <int> measure-generation: root.geometry-measure-generation;
                                    property <string> live-edit-text: paragraph.text;
                                    property <length> live-editor-height: Math.max(paragraph-editor-measure.preferred-height, root.settings-font-size * 1px);
                                    height: paragraph.kind == "image"
                                        ? 352px
                                        : paragraph.kind == "blank"
                                        ? (root.settings-txt-blank-lines == "remove" ? 0px : 24px)
                                        : root.edit-mode && paragraph.editable
                                        ? paragraph.kind == "heading"
                                        ? Math.max(76px + root.settings-paragraph-spacing * root.settings-font-size * 1px,
                                            Math.max(self.live-editor-height, paragraph-body.preferred-height) * (root.document-kind == "EPUB" && !root.settings-epub-override-line-height ? 1.7 : root.settings-line-height) / 1.2
                                            + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                            + 18px)
                                        : Math.max(self.live-editor-height, paragraph-body.preferred-height) * (root.document-kind == "EPUB" && !root.settings-epub-override-line-height ? 1.7 : root.settings-line-height) / 1.2
                                            + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                            + 18px
                                        : paragraph.kind == "heading"
                                            ? 76px + root.settings-paragraph-spacing * root.settings-font-size * 1px
                                            : paragraph-body.preferred-height * (root.document-kind == "EPUB" && !root.settings-epub-override-line-height ? 1.7 : root.settings-line-height) / 1.2
                                                + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                                + 18px;
                                    background: paragraph.index == root.active-paragraph-index
                                        ? (root.settings-effective-theme == "dark" ? #315fc428 : #315fc418)
                                        : transparent;
                                    changed measure-generation => { root.report-block-geometry(paragraph.block-id, self.y / 1px, self.height / 1px); }
                                    paragraph-body := Text {
                                        visible: paragraph.kind != "image" && (!root.edit-mode || !paragraph.editable);
                                        x: Math.max(root.settings-horizontal-margin * 1px, (parent.width - root.settings-content-width * 1px) / 2);
                                        y: paragraph.kind == "heading" ? 18px : 13px;
                                        width: Math.min(parent.width - root.settings-horizontal-margin * 2px, root.settings-content-width * 1px);
                                        text: paragraph.kind == "paragraph" && root.document-kind == "TXT" && root.settings-txt-leading-indent == "clean"
                                            ? root.settings-indent-prefix + paragraph.text
                                            : paragraph.kind == "paragraph" && root.document-kind == "EPUB" && root.settings-epub-override-indent
                                                ? root.settings-indent-prefix + paragraph.text
                                            : paragraph.text;
                                        color: DesignTokens.reader-text;
                                        font-family: root.document-kind == "EPUB" && !root.settings-epub-override-font
                                            ? "Microsoft YaHei UI"
                                            : root.settings-font-family;
                                        font-size: paragraph.kind == "heading"
                                            && (root.document-kind == "TXT" ? root.settings-chapter-title-style == "prominent" : root.settings-epub-publisher-styles)
                                            ? root.settings-font-size * 1px + 5px
                                            : root.document-kind == "EPUB" && !root.settings-epub-override-font-size ? 18px : root.settings-font-size * 1px;
                                        font-weight: paragraph.kind == "heading"
                                            && (root.document-kind == "TXT" ? root.settings-chapter-title-style == "prominent" : root.settings-epub-publisher-styles)
                                            ? 700
                                            : root.settings-font-weight;
                                        letter-spacing: paragraph.kind == "heading" ? 0px : (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px;
                                        horizontal-alignment: paragraph.kind == "heading" ? center : left;
                                        wrap: word-wrap;
                                    }
                                    paragraph-editor-measure := Text {
                                        visible: root.edit-mode && paragraph.editable;
                                        opacity: 0;
                                        x: paragraph-body.x;
                                        y: paragraph-body.y;
                                        width: paragraph-body.width;
                                        text: row.live-edit-text;
                                        font-family: paragraph-body.font-family;
                                        font-size: paragraph-body.font-size;
                                        font-weight: paragraph-body.font-weight;
                                        letter-spacing: paragraph-body.letter-spacing;
                                        horizontal-alignment: paragraph-body.horizontal-alignment;
                                        wrap: word-wrap;
                                    }
                                    if root.edit-mode && paragraph.editable : paragraph-editor := TextInput {
                                        property <int> restore-generation: root.edit-restore-generation;
                                        x: paragraph-body.x;
                                        y: paragraph.kind == "blank" ? 0px : paragraph-body.y;
                                        width: paragraph-body.width;
                                        height: paragraph.kind == "blank"
                                            ? parent.height
                                            : Math.max(root.settings-font-size * 1px, parent.height - self.y - 5px);
                                        accessible-id: "inline-editor-" + paragraph.block-id;
                                        text <=> row.live-edit-text;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: DesignTokens.reader-text;
                                        selection-background-color: DesignTokens.accent-muted;
                                        selection-foreground-color: DesignTokens.reader-text;
                                        font-family: paragraph-body.font-family;
                                        font-size: paragraph-body.font-size;
                                        font-weight: paragraph-body.font-weight;
                                        letter-spacing: paragraph-body.letter-spacing;
                                        horizontal-alignment: paragraph-body.horizontal-alignment;
                                        text-cursor-width: 1px;
                                        changed restore-generation => {
                                            if root.edit-anchor-block-id == paragraph.block-id {
                                                self.focus();
                                                self.set-selection-offsets(root.edit-caret-byte, root.edit-caret-byte);
                                            }
