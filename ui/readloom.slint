                                                root.capture-view-anchor(paragraph.block-id, self.cursor-position-byte-offset, self.y / 1px + row.y / 1px + root.reader-viewport-y / 1px);
                                            }
                                        }
                                    }
                                    if paragraph.kind == "image" && paragraph.has-image : Image {
                                        x: Math.max(root.settings-horizontal-margin * 1px, (parent.width - root.settings-content-width * 1px) / 2);
                                        y: 14px;
                                        width: Math.min(parent.width - root.settings-horizontal-margin * 2px, root.settings-content-width * 1px);
                                        height: 270px;
                                        source: paragraph.image;
                                        image-fit: contain;
                                    }
                                    if root.edit-mode && paragraph.kind == "image" : image-alt-editor := LineEdit {
                                        x: Math.max(root.settings-horizontal-margin * 1px, (parent.width - root.settings-content-width * 1px) / 2);
                                        y: 304px;
                                        width: Math.max(160px, Math.min(parent.width - root.settings-horizontal-margin * 2px, root.settings-content-width * 1px) - 96px);
                                        height: 34px;
                                        accessible-id: "image-alt-editor-" + paragraph.block-id;
                                        text: paragraph.text;
