                                        x: first-body.x; y: pair.first.kind == "blank" ? 0px : first-body.y; width: first-body.width;
                                        height: pair.first.kind == "blank" ? parent.height : Math.max(root.settings-font-size * 1px, parent.height - self.y - 5px);
                                        accessible-id: "inline-editor-" + pair.first.block-id;
                                        text <=> pair-row.first-live-edit-text; single-line: false; wrap: word-wrap; color: DesignTokens.reader-text;
                                        selection-background-color: DesignTokens.accent-muted; selection-foreground-color: DesignTokens.reader-text;
                                        font-family: first-body.font-family; font-size: first-body.font-size; font-weight: first-body.font-weight; letter-spacing: first-body.letter-spacing;
                                        text-cursor-width: 1px;
                                        changed restore-generation => { if root.edit-anchor-block-id == pair.first.block-id { self.focus(); self.set-selection-offsets(root.edit-caret-byte, root.edit-caret-byte); } }
                                        edited => { root.active-paragraph-index = pair.first.index; root.replace-block-text(pair.first.block-id, self.text, self.cursor-position_byte-offset); }
                                        key-pressed(event) => {
                                            if self.preedit-text.is-empty && self.cursor-position-byte-offset == self.anchor-position-byte-offset {
                                                if event.text == Key.Backspace && root.join-adjacent-text(pair.first.block-id, "previous", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) { return accept; }
                                                if event.text == Key.Delete && root.join-adjacent-text(pair.first.block-id, "next", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) { return accept; }
                                            }
                                            return reject;
                                        }
                                        cursor-position-changed(position) => {
                                            if !root.view-anchor-restore-pending {
                                                root.active-paragraph-index = pair.first.index;
                                                root.capture-view-anchor(pair.first.block-id, self.cursor-position-byte-offset, self.y / 1px + pair-row.y / 1px + root.reader-viewport-y / 1px);
                                            }
                                        }
                                    }
                                    if root.edit-mode && pair.has-second && pair.second.editable : second-editor := TextInput {
                                        property <int> restore-generation: root.edit-restore-generation;
