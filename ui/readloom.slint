                                }
                                if root.reader-side-panel == "search" : Text { height: 24px; text: "共 " + (root.search-results-truncated ? "500+" : root.search-results.length) + " 条结果"; color: DesignTokens.text-muted; font-size: DesignTokens.type-item-title; vertical-alignment: center; }
                                if root.reader-side-panel == "search" && root.search-results.length > 0 : ListView {
                                    accessible-id: "reader-search-results";
                                    min-height: 0px;
                                    vertical-stretch: 1;
                                    for result in root.search-results : Rectangle {
                                        height: 76px;
                                        border-radius: DesignTokens.radius-small;
                                        background: epub-result-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                        VerticalLayout { padding: DesignTokens.space-2; spacing: DesignTokens.space-1; Text { height: 19px; text: result.label; color: DesignTokens.accent; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-section-title; overflow: elide; } Text { text: result.preview; color: DesignTokens.text-secondary; font-size: 13px; wrap: word-wrap; overflow: elide; } }
                                        epub-result-touch := TouchArea {
                                            accessible-role: list-item;
                                            accessible-label: result.label;
                                            clicked => { root.open-epub-location(result.chapter-index, result.paragraph-index); }
                                        }
                                    }
                                }
                                if root.reader-side-panel == "search" && root.search-results.length == 0 : Text { min-height: 52px; vertical-stretch: 1; text: "输入关键词后，这里会显示匹配位置和正文摘要。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-item-title; wrap: word-wrap; }

                                if root.reader-side-panel == "bookmarks" : HorizontalLayout {
                                    height: 36px;
                                    Text { text: "共 " + root.bookmarks.length + " 个书签"; color: DesignTokens.text-muted; font-size: DesignTokens.type-item-title; vertical-alignment: center; }
                                    ActionButton { width: 72px; text: "添加当前位置"; clicked => { root.add-bookmark(); } }
                                }
                                if root.reader-side-panel == "bookmarks" && root.bookmarks.length > 0 : ListView {
                                    accessible-id: "reader-bookmarks";
                                    min-height: 0px;
                                    vertical-stretch: 1;
                                    for mark in root.bookmarks : Rectangle {
                                        height: 68px;
                                        border-radius: DesignTokens.radius-medium;
                                        background: bookmark-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                        bookmark-touch := TouchArea {
                                            accessible-role: list-item;
                                            accessible-label: mark.label;
                                            clicked => {
                                                if (root.document-kind == "EPUB") {
                                                    root.open-epub-location(mark.chapter-index, mark.paragraph-index);
                                                } else {
                                                    root.navigate-to(mark.paragraph-index);
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 8px;
                                            padding-top: 8px;
                                            padding-bottom: 7px;
                                            spacing: 3px;
                                            HorizontalLayout {
                                                height: 23px;
                                                Text { text: mark.label; color: DesignTokens.accent; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; overflow: elide; vertical-alignment: center; }
                                                SettingValueButton { accessible-role: button; accessible-id: "delete-bookmark"; width: 38px; height: 23px; text: "删除"; clicked => { root.delete-bookmark(mark.id); } }
                                            }
                                            Text { text: mark.detail; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; overflow: elide; vertical-alignment: center; }
                                        }
                                    }
                                }
                                if root.reader-side-panel == "bookmarks" && root.bookmarks.length == 0 : Text { min-height: 52px; vertical-stretch: 1; text: "还没有书签。点击“添加当前位置”即可保存当前阅读位置。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-item-title; wrap: word-wrap; }

                                if root.reader-side-panel == "info" : VerticalLayout {
                                    spacing: 9px;
                                    Text { height: 25px; text: root.document-title; color: DesignTokens.accent; font-size: 14px; font-weight: DesignTokens.weight-section-title; overflow: elide; }
                                    Text { height: 22px; text: "作者：" + (root.document-author == "" ? "未知" : root.document-author); color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; overflow: elide; }
                                    Text { height: 22px; text: "格式：" + root.document-kind; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; }
                                    Text { height: 22px; text: "章节：" + root.chapters.length; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; }
                                    Text { height: 54px; text: "路径：" + root.document-path; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; wrap: word-wrap; overflow: elide; }
                                    Text { height: 42px; text: root.document-kind == "EPUB" ? "EPUB 以只读方式打开；标题、封面、目录与正文图片来自书籍文件。" : "TXT 可在编辑模式下修改并保存。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; wrap: word-wrap; }
                                }
                                if root.reader-side-panel == "info" : Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }
            }

            if root.settings-open : Rectangle {
                x: root.workspace-pane-width + 8px;
                y: 0px;
                width: parent.width - root.workspace-pane-width - 8px;
                height: parent.height;
                background: DesignTokens.background;

                HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: root.settings-navigation-width;
                        background: DesignTokens.surface-subtle;
                        VerticalLayout {
                            padding-left: DesignTokens.space-4;
                            padding-right: DesignTokens.space-4;
                            padding-top: DesignTokens.space-4;
                            padding-bottom: DesignTokens.space-2;
                            spacing: 0px;
                            Text {
                                height: 46px;
                                text: "设置";
                                color: DesignTokens.text-primary;
                                font-size: 20px;
                                font-weight: DesignTokens.weight-page-title;
                                vertical-alignment: center;
                            }
                            ScrollView {
                                viewport-width: self.width;
                                viewport-height: Math.max(self.height, settings-navigation.preferred-height);
                                settings-navigation := VerticalLayout {
                                width: parent.width;
                                spacing: 1px;
                            SettingsGroupLabel { label: "外观"; dark: root.settings-effective-theme == "dark"; }
                            SettingsPageItem { label: "主题"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "appearance.theme"; clicked => { root.settings-section = "appearance.theme"; } }
                            SettingsPageItem { label: "字体"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "appearance.font"; clicked => { root.settings-section = "appearance.font"; } }
                            SettingsPageItem { label: "页面布局"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "appearance.layout"; clicked => { root.settings-section = "appearance.layout"; } }

                            SettingsGroupLabel { label: "阅读"; dark: root.settings-effective-theme == "dark"; }
                            SettingsPageItem { label: "阅读排版"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "reading.typography"; clicked => { root.settings-section = "reading.typography"; } }

                            SettingsGroupLabel { label: "操作"; dark: root.settings-effective-theme == "dark"; }
                            SettingsPageItem { label: "快捷键"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "controls.shortcuts"; clicked => { root.settings-section = "controls.shortcuts"; } }

                            SettingsGroupLabel { label: "书籍"; dark: root.settings-effective-theme == "dark"; }
                            SettingsPageItem { label: "章节识别"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "books.chapters"; clicked => { root.settings-section = "books.chapters"; } }

                            SettingsGroupLabel { label: "数据"; dark: root.settings-effective-theme == "dark"; }
                            SettingsPageItem { label: "备份"; dark: root.settings-effective-theme == "dark"; active: root.settings-section == "data.backup"; clicked => { root.settings-section = "data.backup"; } }
                                Rectangle { height: 8px; background: transparent; }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 6px;
                        background: transparent;
                        Rectangle {
                            x: (parent.width - 1px) / 2;
                            width: 1px;
                            height: parent.height;
                            background: DesignTokens.border-subtle;
                        }
                        settings-navigation-resize := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: col-resize;
                            moved => {
                                if (self.pressed) {
                                    root.preview-pane-resize("settings-navigation", Math.max(180px, Math.min(360px, self.absolute-position.x + self.mouse-x - root.workspace-pane-width - 8px)) / 1px);
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && root.pane-resize-preview-kind == "settings-navigation") {
                                    root.commit-pane-resize("settings-navigation", root.pane-resize-preview-width);
                                } else if (event.kind == PointerEventKind.cancel && root.pane-resize-preview-kind == "settings-navigation") {
                                    root.pane-resize-preview-active = false;
                                    root.pane-resize-preview-kind = "";
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: DesignTokens.surface;
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            viewport-width: self.width;
                            viewport-height: Math.max(self.height, settings-content.preferred-height);
                            settings-content := VerticalLayout {
                            width: parent.width;
                            padding-left: Math.max(DesignTokens.space-8, (parent.width - 1180px) / 2);
                            padding-right: Math.max(DesignTokens.space-8, (parent.width - 1180px) / 2);
                            padding-top: DesignTokens.space-6;
                            padding-bottom: DesignTokens.space-10;
                            spacing: DesignTokens.space-6;
                            VerticalLayout {
                                height: 70px;
                                spacing: DesignTokens.space-1;
                                Text {
                                    text: root.settings-section == "appearance.theme" ? "主题"
                                        : root.settings-section == "appearance.font" ? "字体"
                                        : root.settings-section == "appearance.layout" ? "页面布局"
                                        : root.settings-section == "reading.typography" ? "阅读排版"
                                        : root.settings-section == "controls.shortcuts" ? "快捷键"
                                        : root.settings-section == "books.chapters" ? "章节识别"
                                        : root.settings-section == "data.backup" ? "备份与恢复" : "设置";
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.type-page-title; font-weight: DesignTokens.weight-page-title; vertical-alignment: center;
                                }
                                Text {
                                    text: root.settings-section == "reading.typography"
                                        ? "调整字体、段落和页面留白，预览会实时更新。"
                                        : root.settings-section == "appearance.theme"
                                            ? "选择舒适的界面主题与阅读背景。"
                                            : "修改后立即生效，并安全保存到本机。";
                                    color: DesignTokens.text-muted;
                                    font-size: DesignTokens.type-body;
                                    vertical-alignment: center;
                                }
                            }

                            if root.settings-section == "appearance.theme" : VerticalLayout {
                                spacing: DesignTokens.space-4;
                                SettingsSectionHeader { title: "界面主题"; description: "在亮色、暗色与 Windows 系统主题之间切换"; }
                                Rectangle { height: 58px; background: transparent;
                                    HorizontalLayout { padding-left: DesignTokens.space-3; padding-right: DesignTokens.space-2; spacing: DesignTokens.space-2;
                                        VerticalLayout { min-width: 180px; spacing: 2px; Text { text: "配色模式"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; } Text { text: "界面与阅读背景会同步更新"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; vertical-alignment: center; } }
                                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                        SettingValueButton { text: "亮色"; selected: root.settings-theme == "light"; clicked => { root.update-setting("theme", "light"); } }
                                        SettingValueButton { text: "暗色"; selected: root.settings-theme == "dark"; clicked => { root.update-setting("theme", "dark"); } }
                                        SettingValueButton { text: "跟随 Windows"; selected: root.settings-theme == "system"; width: 112px; clicked => { root.update-setting("theme", "system"); } }
                                    }
                                }
                                SettingsSeparator { }
                                SettingsSectionHeader { title: "阅读背景"; description: "可选背景图片只显示在正文区域，并保留文字对比度"; }
                                Rectangle { height: 136px; border-radius: DesignTokens.radius-medium; border-width: 1px; border-color: DesignTokens.border-subtle; background: DesignTokens.surface-subtle;
                                    VerticalLayout { padding: DesignTokens.space-3;
                                        BackgroundSettingControl {
                                            label: "自定义背景";
                                            display-opacity: root.settings-background-opacity;
                                            preview-image: root.settings-background-image;
                                            has-preview: root.settings-has-background;
                                            opacity-changed(value) => { root.change-setting("backgroundOpacityAbsolute", value); }
                                            choose => { root.choose-background(); }
                                            clear => { root.clear-background(); }
                                        }
                                    }
                                }
                                Text { height: 20px; text: "背景设置也会显示在“页面布局”中，两处修改实时同步。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; }
                            }

                            if root.settings-section == "appearance.font" : VerticalLayout {
                                spacing: DesignTokens.space-4;
                                SettingsSectionHeader { title: "阅读字体"; description: "选择用于 TXT 和可覆盖 EPUB 正文的本地字体"; }
                                Rectangle { height: 150px; background: transparent;
                                    VerticalLayout { spacing: DesignTokens.space-2;
                                        HorizontalLayout { height: 34px; spacing: 7px;
                                            SettingValueButton { text: "系统默认"; selected: root.settings-font-id == "system"; width: 88px; clicked => { root.update-setting("font", "system"); } }
                                            SettingValueButton { text: "思源宋体"; selected: root.settings-font-id == "source-han-serif"; width: 88px; clicked => { root.update-setting("font", "source-han-serif"); } }
                                            SettingValueButton { text: "Noto Serif CJK"; selected: root.settings-font-id == "noto-serif-cjk"; width: 116px; clicked => { root.update-setting("font", "noto-serif-cjk"); } }
                                        }
                                        HorizontalLayout { height: 34px; spacing: 7px;
                                            SettingValueButton { text: "思源黑体"; selected: root.settings-font-id == "source-han-sans"; width: 88px; clicked => { root.update-setting("font", "source-han-sans"); } }
                                            SettingValueButton { text: "Noto Sans CJK"; selected: root.settings-font-id == "noto-sans-cjk"; width: 116px; clicked => { root.update-setting("font", "noto-sans-cjk"); } }
                                            SettingValueButton { text: "霞鹜文楷"; selected: root.settings-font-id == "lxgw-wenkai"; width: 88px; clicked => { root.update-setting("font", "lxgw-wenkai"); } }
                                        }
                                        Text {
                                            height: 22px;
                                            text: "当前实际字体：" + root.settings-font-family + (root.settings-font-fallback ? "（所选字体未安装，已自动回退）" : "");
                                            color: root.settings-font-fallback ? DesignTokens.warning : DesignTokens.text-secondary;
                                            font-family: root.settings-font-family;
                                            font-size: 10px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text { height: 34px; text: "字体不会内置，也不会联网下载；所选字体未安装时自动回退到系统中文字体。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; }
                            }

                            if root.settings-section == "appearance.layout" : VerticalLayout {
                                spacing: DesignTokens.space-4;
                                SettingsSectionHeader { title: "窗口与书库"; description: "控制书库密度和窗口关闭行为"; }
                                Rectangle { height: 258px; background: transparent;
                                    VerticalLayout { spacing: DesignTokens.space-3;
                                        HorizontalLayout { height: 42px; spacing: DesignTokens.space-2; Text { text: "书库每行"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                            Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                            SettingValueButton { text: "3 本"; selected: root.settings-library-columns == 3; clicked => { root.update-setting("libraryColumns", "3"); } }
                                            SettingValueButton { text: "4 本"; selected: root.settings-library-columns == 4; clicked => { root.update-setting("libraryColumns", "4"); } }
                                            SettingValueButton { text: "5 本"; selected: root.settings-library-columns == 5; clicked => { root.update-setting("libraryColumns", "5"); } }
                                        }
                                        BackgroundSettingControl {
                                            label: "背景图片";
                                            display-opacity: root.settings-background-opacity;
                                            preview-image: root.settings-background-image;
                                            has-preview: root.settings-has-background;
                                            opacity-changed(value) => { root.change-setting("backgroundOpacityAbsolute", value); }
                                            choose => { root.choose-background(); }
                                            clear => { root.clear-background(); }
                                        }
                                        HorizontalLayout { height: 32px; spacing: 10px;
                                            Text { text: "最小化时隐藏到托盘"; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; vertical-alignment: center; }
                                            Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                            SettingSwitch { active: root.settings-minimize-to-tray; toggled => { root.update-setting("minimizeToTray", root.settings-minimize-to-tray ? "false" : "true"); } }
                                        }
                                        HorizontalLayout { height: 32px; spacing: 10px;
                                            Text { text: "关闭窗口"; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; vertical-alignment: center; }
                                            Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                            SettingValueButton { text: "退出"; selected: root.settings-close-action == "exit"; clicked => { root.update-setting("closeAction", "exit"); } }
                                            SettingValueButton { text: "最小化到托盘"; selected: root.settings-close-action == "tray"; width: 116px; clicked => { root.update-setting("closeAction", "tray"); } }
                                        }
                                    }
                                }
                                Text { height: 20px; text: "背景设置与“主题”页面共用同一份数据。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; }
                            }

                            if root.settings-section == "reading.typography" : reading-settings-grid := GridLayout {
                                spacing: DesignTokens.space-6;
                                VerticalLayout {
                                    row: 0;
                                    col: 0;
                                    spacing: DesignTokens.space-6;
                                    HorizontalLayout {
                                        height: 42px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "排版参数"; color: DesignTokens.text-primary; font-size: DesignTokens.type-section-title; font-weight: DesignTokens.weight-section-title; vertical-alignment: center; }
                                            Text { text: "修改会实时作用于当前 TXT / EPUB，并自动保存"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; vertical-alignment: center; }
                                        }
                                        ActionButton { width: 116px; text: "恢复默认排版"; clicked => { root.update-setting("reading.reset", ""); } }
                                    }

                                    Rectangle {
                                        height: 280px; background: transparent;
                                        VerticalLayout {
                                            spacing: DesignTokens.space-2;
                                            SettingsSectionHeader { title: "字体"; description: "控制正文的字体气质、大小与字面密度"; }
                                            Rectangle {
                                                height: 56px; border-radius: DesignTokens.radius-small; background: font-row-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                                font-row-touch := TouchArea { enabled: false; }
                                                HorizontalLayout { padding-left: DesignTokens.space-3; padding-right: DesignTokens.space-2; spacing: DesignTokens.space-3;
                                                    VerticalLayout { min-width: 156px; spacing: 2px;
                                                        Text { text: "正文字体"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                                        Text { text: "选择长时间阅读使用的字体"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; vertical-alignment: center; }
                                                    }
                                                    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                                                    Text { width: 146px; text: root.settings-font-family; color: DesignTokens.text-secondary; font-size: DesignTokens.type-body; overflow: elide; horizontal-alignment: right; vertical-alignment: center; }
                                                    SettingValueButton { width: 72px; height: 30px; text: "选择字体"; clicked => { root.settings-section = "appearance.font"; } }
                                                }
                                            }
                                            StepSettingRow { label: "字号"; description: "调整正文文字大小"; value: root.settings-font-size + " px"; decrease => { root.change-setting("fontSize", -1); } increase => { root.change-setting("fontSize", 1); } }
                                            StepSettingRow { label: "字重"; description: "控制正文笔画的视觉重量"; value: root.settings-font-weight; decrease-text: "−100"; increase-text: "+100"; decrease => { root.change-setting("fontWeight", -100); } increase => { root.change-setting("fontWeight", 100); } }
                                            StepSettingRow { label: "字间距"; description: "微调字符之间的呼吸感"; value: root.settings-letter-spacing + " em"; decrease => { root.change-setting("letterSpacing", -0.01); } increase => { root.change-setting("letterSpacing", 0.01); } }
                                        }
                                    }

                                    SettingsSeparator { }

                                    Rectangle {
                                        height: 282px; background: transparent;
                                        VerticalLayout {
                                            spacing: DesignTokens.space-2;
                                            SettingsSectionHeader { title: "段落"; description: "调整正文行与段之间的阅读节奏"; }
                                            StepSettingRow { label: "首行缩进"; description: "设置每段开头的缩进宽度"; value: root.settings-first-line-indent + " em"; decrease => { root.change-setting("firstLineIndent", -0.25); } increase => { root.change-setting("firstLineIndent", 0.25); } }
                                            StepSettingRow { label: "行间距"; description: "调整正文行与行的距离"; value: root.settings-line-height + "×"; decrease => { root.change-setting("lineHeight", -0.05); } increase => { root.change-setting("lineHeight", 0.05); } }
                                            StepSettingRow { label: "段落间距"; description: "调整相邻段落之间的留白"; value: root.settings-paragraph-spacing + " em"; decrease => { root.change-setting("paragraphSpacing", -0.05); } increase => { root.change-setting("paragraphSpacing", 0.05); } }
                                            SegmentedSettingRow { label: "正文对齐"; description: "选择正文每行的对齐方式"; first-text: "两端对齐"; second-text: "左对齐"; selected-index: root.settings-text-alignment == "justify" ? 0 : 1; selected(index) => { root.update-setting("alignment", index == 0 ? "justify" : "left"); } }
                                        }
                                    }

                                    SettingsSeparator { }

                                    Rectangle {
                                        height: 282px; background: transparent;
                                        VerticalLayout {
                                            spacing: DesignTokens.space-2;
                                            SettingsSectionHeader { title: "页面"; description: "限制正文宽度与四周留白，避免大屏文本过长"; }
                                            StepSettingRow { label: "正文宽度"; description: "限制正文每行的最大阅读宽度"; value: root.settings-content-width + " px"; decrease-text: "−20"; increase-text: "+20"; decrease => { root.change-setting("contentWidth", -20); } increase => { root.change-setting("contentWidth", 20); } }
                                            StepSettingRow { label: "左右边距"; description: "保留正文两侧的安静空间"; value: root.settings-horizontal-margin + " px"; decrease-text: "−4"; increase-text: "+4"; decrease => { root.change-setting("horizontalMargin", -4); } increase => { root.change-setting("horizontalMargin", 4); } }
                                            StepSettingRow { label: "上下边距"; description: "控制章节与窗口边缘的距离"; value: root.settings-vertical-margin + " px"; decrease-text: "−4"; increase-text: "+4"; decrease => { root.change-setting("verticalMargin", -4); } increase => { root.change-setting("verticalMargin", 4); } }
                                            SegmentedSettingRow { label: "阅读栏数"; description: "宽屏时可使用双栏阅读"; first-text: "单栏"; second-text: "双栏"; selected-index: root.settings-reading-columns == 1 ? 0 : 1; selected(index) => { root.update-setting("readingColumns", index == 0 ? "1" : "2"); } }
                                        }
                                    }

                                    SettingsSeparator { }

                                    Rectangle {
                                        height: 292px; background: transparent;
                                        VerticalLayout {
                                            spacing: DesignTokens.space-2;
                                            SettingsSectionHeader { title: "TXT 排版"; description: "清理常见纯文本格式问题，不改变原文件内容"; }
                                            SegmentedSettingRow { label: "段首空格"; description: "清理连续空格并使用统一首行缩进"; first-text: "清理"; second-text: "保留"; selected-index: root.settings-txt-leading-indent == "clean" ? 0 : 1; selected(index) => { root.update-setting("txtIndent", index == 0 ? "clean" : "preserve"); } }
                                            SegmentedSettingRow { label: "空行处理"; description: "控制连续空行的显示方式"; first-text: "保留"; second-text: "合并"; third-text: "隐藏"; selected-index: root.settings-txt-blank-lines == "preserve" ? 0 : root.settings-txt-blank-lines == "single" ? 1 : 2; selected(index) => { root.update-setting("txtBlankLines", index == 0 ? "preserve" : index == 1 ? "single" : "remove"); } }
                                            ToggleSettingRow { label: "自动合并疑似错误换行"; description: "适合段落被硬换行的文本，默认关闭"; active: root.settings-merge-wrapped-lines; toggled => { root.update-setting("mergeWrappedLines", root.settings-merge-wrapped-lines ? "false" : "true"); } }
                                            SegmentedSettingRow { label: "章节标题"; description: "选择 TXT 章节标题的视觉层级"; first-text: "突出"; second-text: "紧凑"; third-text: "跟随正文"; selected-index: root.settings-chapter-title-style == "prominent" ? 0 : root.settings-chapter-title-style == "compact" ? 1 : 2; selected(index) => { root.update-setting("chapterTitleStyle", index == 0 ? "prominent" : index == 1 ? "compact" : "plain"); } }
                                        }
                                    }

                                    SettingsSeparator { }

                                    Rectangle {
                                        height: 430px; background: transparent;
                                        VerticalLayout {
                                            spacing: DesignTokens.space-2;
                                            SettingsSectionHeader { title: "EPUB 排版"; description: "优先尊重书籍样式；覆盖项仅作用于正文"; }
                                            ToggleSettingRow { label: "使用书籍原始样式"; description: "保留 EPUB 自带的章节排版与样式"; active: root.settings-epub-publisher-styles; toggled => { root.update-setting("epubPublisher", root.settings-epub-publisher-styles ? "false" : "true"); } }
                                            ToggleSettingRow { label: "使用书籍内嵌字体"; description: "书籍提供字体时优先使用"; active: root.settings-epub-embedded-fonts; toggled => { root.update-setting("epubEmbedded", root.settings-epub-embedded-fonts ? "false" : "true"); } }
                                            Text { height: 28px; text: "正文覆盖"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; font-weight: DesignTokens.weight-item-title; vertical-alignment: bottom; }
                                            ToggleSettingRow { label: "覆盖字体"; description: "忽略 EPUB 正文的字体设置"; active: root.settings-epub-override-font; toggled => { root.update-setting("epubFont", root.settings-epub-override-font ? "false" : "true"); } }
                                            ToggleSettingRow { label: "覆盖字号"; description: "使用上方统一的正文字号"; active: root.settings-epub-override-font-size; toggled => { root.update-setting("epubFontSize", root.settings-epub-override-font-size ? "false" : "true"); } }
                                            ToggleSettingRow { label: "覆盖首行缩进"; description: "使用上方统一的首行缩进"; active: root.settings-epub-override-indent; toggled => { root.update-setting("epubIndent", root.settings-epub-override-indent ? "false" : "true"); } }
                                            ToggleSettingRow { label: "覆盖行间距"; description: "使用上方统一的正文行间距"; active: root.settings-epub-override-line-height; toggled => { root.update-setting("epubLineHeight", root.settings-epub-override-line-height ? "false" : "true"); } }
                                            ToggleSettingRow { label: "覆盖段落间距"; description: "使用上方统一的段落留白"; active: root.settings-epub-override-paragraph-spacing; toggled => { root.update-setting("epubParagraphSpacing", root.settings-epub-override-paragraph-spacing ? "false" : "true"); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    row: root.width >= 1500px ? 0 : 1;
                                    col: root.width >= 1500px ? 1 : 0;
                                    min-width: root.width >= 1500px ? 300px : 0px;
                                    preferred-width: root.width >= 1500px ? 340px : 0px;
                                    min-height: root.width >= 1500px ? 0px : 240px;
                                    border-radius: DesignTokens.radius-large;
                                    border-width: 1px;
                                    border-color: DesignTokens.border-subtle;
                                    background: DesignTokens.surface-subtle;
                                    VerticalLayout {
                                        padding-left: DesignTokens.space-6;
                                        padding-right: DesignTokens.space-6;
                                        padding-top: DesignTokens.space-5;
                                        padding-bottom: DesignTokens.space-5;
                                        spacing: root.settings-paragraph-spacing * root.settings-font-size * 1px + 6px;
                                        Text { height: 26px; text: "阅读预览"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; font-weight: DesignTokens.weight-item-title; }
                                        Text { height: 38px; text: "第一章 初入江湖"; color: DesignTokens.text-primary; font-family: root.settings-font-family; font-size: Math.min(root.settings-font-size + 3, 24) * 1px; font-weight: Math.max(root.settings-font-weight, 650); wrap: word-wrap; }
                                        Rectangle { height: preview-body.preferred-height * root.settings-line-height / 1.2;
                                            preview-body := Text { width: parent.width; text: root.settings-indent-prefix + "清晨的雾气还未散尽，山间小道上只听见自己的脚步声。远处的灯火一盏一盏亮起，街道逐渐安静下来。"; color: DesignTokens.text-primary; font-family: root.settings-font-family; font-size: Math.min(root.settings-font-size, 19) * 1px; font-weight: root.settings-font-weight; letter-spacing: (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px; wrap: word-wrap; }
                                        }
                                        Rectangle { height: preview-body-second.preferred-height * root.settings-line-height / 1.2;
                                            preview-body-second := Text { width: parent.width; text: root.settings-indent-prefix + "他合上书，看向窗外。排版修改会立即反映在这里。"; color: DesignTokens.text-secondary; font-family: root.settings-font-family; font-size: Math.min(root.settings-font-size, 19) * 1px; font-weight: root.settings-font-weight; letter-spacing: (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px; wrap: word-wrap; }
                                        }
                                        Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                                        SettingsSeparator { }
                                        HorizontalLayout { height: 24px;
                                            Text { text: root.settings-font-size + " px · " + root.settings-line-height + "×"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; vertical-alignment: center; }
                                            Text { text: root.settings-content-width + " px"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            if root.settings-section == "controls.shortcuts" : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 44px;
                                    VerticalLayout {
                                        Text { height: 22px; text: "点击快捷键框后直接按下组合键"; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                        Text { height: 18px; text: "Esc 取消录入，Backspace / Delete 清除；重复组合会被拒绝。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-caption; vertical-alignment: center; }
                                    }
                                    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                    ActionButton { width: 92px; height: 34px; text: "全部清除"; clicked => { root.clear-shortcuts(); } }
                                }
                                HorizontalLayout { height: 260px; spacing: 14px;
                                    Rectangle { border-radius: DesignTokens.radius-medium; border-width: 1px; border-color: DesignTokens.border-subtle; background: DesignTokens.surface-subtle;
                                        VerticalLayout { padding-left: 8px; padding-right: 8px;
                                            ShortcutSettingRow { action: "open"; label: "打开文件"; value: root.shortcut-open; capturing: root.shortcut-capture-action == "open"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "save"; label: "保存"; value: root.shortcut-save; capturing: root.shortcut-capture-action == "save"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "saveAs"; label: "另存为"; value: root.shortcut-save-as; capturing: root.shortcut-capture-action == "saveAs"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "close"; label: "关闭当前图书"; value: root.shortcut-close; capturing: root.shortcut-capture-action == "close"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "toggleEdit"; label: "切换编辑模式"; value: root.shortcut-toggle-edit; capturing: root.shortcut-capture-action == "toggleEdit"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                        }
                                    }
                                    Rectangle { border-radius: DesignTokens.radius-medium; border-width: 1px; border-color: DesignTokens.border-subtle; background: DesignTokens.surface-subtle;
                                        VerticalLayout { padding-left: 8px; padding-right: 8px;
                                            ShortcutSettingRow { action: "previousChapter"; label: "上一章"; value: root.shortcut-previous-chapter; capturing: root.shortcut-capture-action == "previousChapter"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "nextChapter"; label: "下一章"; value: root.shortcut-next-chapter; capturing: root.shortcut-capture-action == "nextChapter"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "bookmark"; label: "添加书签"; value: root.shortcut-bookmark; capturing: root.shortcut-capture-action == "bookmark"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "showLibrary"; label: "打开书库"; value: root.shortcut-show-library; capturing: root.shortcut-capture-action == "showLibrary"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                            ShortcutSettingRow { action: "showSettings"; label: "打开设置"; value: root.shortcut-show-settings; capturing: root.shortcut-capture-action == "showSettings"; capture(action) => { root.begin-shortcut-capture(action); } clear(action) => { root.set-shortcut(action, ""); } }
                                        }
                                    }
                                }
                            }

                            if root.settings-section == "books.chapters" : VerticalLayout {
                                spacing: 12px;
                                Text { height: 34px; text: "TXT 章节标题识别正则 · 与正文净化、阅读排版相互独立"; color: DesignTokens.text-primary; font-size: DesignTokens.type-body; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                TextEdit { height: 190px; text <=> root.settings-chapter-pattern; font-family: "Cascadia Mono"; font-size: 11px; wrap: word-wrap; edited(text) => { root.settings-chapter-pattern = text; } }
                                Text { height: 28px; text: root.settings-pattern-error == "" ? "修改后点击应用；打开或刷新 TXT 时使用新规则。" : root.settings-pattern-error; color: root.settings-pattern-error == "" ? DesignTokens.text-muted : DesignTokens.danger; font-size: DesignTokens.type-secondary; vertical-alignment: center; }
                                HorizontalLayout { height: 36px; spacing: 8px; ActionButton { text: "应用规则"; primary: true; clicked => { root.set-chapter-pattern(root.settings-chapter-pattern); } } ActionButton { text: "恢复默认"; clicked => { root.reset-chapter-pattern(); } } }
                            }

                            if root.settings-section == "data.backup" : VerticalLayout {
                                spacing: 12px;
                                Rectangle { height: 122px; border-radius: DesignTokens.radius-medium; border-width: 1px; border-color: DesignTokens.border-subtle; background: DesignTokens.surface-subtle;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;
                                        Text { height: 20px; text: "内容备份位置"; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; }
                                        Text { height: 25px; text: root.settings-backup-path == "" ? "每次备份时可命名并选择保存位置" : root.settings-backup-path; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; overflow: elide; }
                                        HorizontalLayout {
                                            height: 34px;
                                            spacing: 8px;
                                            ActionButton { width: 92px; text: "默认文件夹"; clicked => { root.choose-backup-path(); } }
                                            ActionButton { width: 90px; text: "命名并备份"; primary: true; clicked => { root.create-backup(); } }
                                            ActionButton { width: 102px; text: "选择多份恢复"; clicked => { root.restore-backup(); } }
                                            ActionButton { width: 112px; text: "恢复目录内全部"; clicked => { root.restore-backup-directory(); } }
                                        }
                                    }
                                }
                                Text { height: 42px; text: "ZIP Deflate 流式压缩，按 SHA-256 内容去重。只备份有效书籍内容，不包含设置、书签、进度、分组和阅读记录。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; }
                                Text { height: 60px; text: root.settings-backup-result; color: DesignTokens.accent; font-size: DesignTokens.type-secondary; wrap: word-wrap; }
                            }

                            Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            x: 0px;
            y: parent.height - 27px;
            width: parent.width;
            height: 27px;
            background: DesignTokens.surface-subtle;
            Rectangle { y: 0; width: parent.width; height: 1px; background: DesignTokens.border-subtle; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    text: root.status-text;
                    color: DesignTokens.text-muted;
                    font-size: DesignTokens.type-secondary;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.settings-open || root.reader-open : Text {
                    width: 170px;
                    text: root.settings-open ? "设置已本地持久化" : "段落 " + (root.active-paragraph-index + 1) + " / " + root.document-paragraph-count;
                    color: DesignTokens.text-muted;
                    font-size: DesignTokens.type-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // Recreate the two persistent chrome regions when the main view switches.
        // This avoids stale retained layers in the Windows FemtoVG backend.
        if root.reader-open : BrandContent {
            x: 0px;
            y: 0px;
            width: root.workspace-pane-width;
            height: 48px;
        }
        if root.reader-open : ActionButton {
            x: 10px;
            y: 59px;
            width: root.workspace-pane-width - 20px;
            height: 42px;
            text: "打开文件";
            primary: true;
            clicked => { root.open-file-hint(); }
        }

        if root.pane-resize-preview-active : Rectangle {
            x: root.pane-resize-preview-x - 1px;
            y: 48px;
            width: 3px;
            height: parent.height - 48px;
            background: DesignTokens.accent;
        }

        if root.group-picker-open : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #11182778;
            group-picker-blocker := TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(470px, parent.width - 48px);
                height: Math.min(520px, Math.min(parent.height - 64px, 178px + root.library-group-targets.length * 52px));
                border-radius: 16px;
                border-width: 1px;
                border-color: DesignTokens.border-subtle;
                background: DesignTokens.surface;

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 22px;
                    padding-bottom: 20px;
                    spacing: 10px;
                    Text { height: 28px; text: "选择目标分组"; color: DesignTokens.text-primary; font-size: 19px; font-weight: DesignTokens.weight-page-title; vertical-alignment: center; }
                    Text { height: 24px; text: "《" + root.group-picker-title + "》"; color: DesignTokens.text-muted; font-size: DesignTokens.type-body; overflow: elide; vertical-alignment: center; }
                    Text { height: 20px; text: "点击一个分组完成移动；“未分组”用于移出自建分组。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; vertical-alignment: center; }
                    ListView {
                        accessible-id: "library-group-picker";
                        min-height: 0px;
                        vertical-stretch: 1;
                        for shelf in root.library-group-targets : Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: group-target-touch.has-hover ? DesignTokens.accent-border : DesignTokens.border-subtle;
                            background: group-target-touch.has-hover ? DesignTokens.accent-muted : DesignTokens.surface-subtle;
                            HorizontalLayout {
                                padding-left: 13px;
                                padding-right: 13px;
                                spacing: 10px;
                                Text { text: shelf.name; color: DesignTokens.text-primary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; vertical-alignment: center; }
                                Text { width: 54px; text: shelf.count + " 本"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            group-target-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "移到" + shelf.name;
                                clicked => {
                                    root.group-picker-open = false;
                                    root.move-library-book(root.group-picker-path, shelf.id, shelf.name);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        ActionButton { width: 84px; text: "取消"; clicked => { root.group-picker-open = false; } }
                    }
                }
            }
        }

        if root.delete-group-confirm-open : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #11182778;
            delete-group-blocker := TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(460px, parent.width - 48px);
                height: 254px;
                border-radius: 16px;
                border-width: 1px;
                border-color: DesignTokens.border-subtle;
                background: DesignTokens.surface;

                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 24px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    Text { height: 30px; text: "删除分组"; color: DesignTokens.text-primary; font-size: 19px; font-weight: DesignTokens.weight-page-title; vertical-alignment: center; }
                    Text { height: 28px; text: "确定删除“" + root.delete-group-confirm-name + "”吗？"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; wrap: word-wrap; vertical-alignment: center; }
                    Rectangle {
                        height: 58px;
                        border-radius: 9px;
                        background: DesignTokens.surface-subtle;
                        Text {
                            x: 13px; y: 9px; width: parent.width - 26px; height: parent.height - 18px;
                            text: "组内图书会回到“未分组”；阅读进度、书签和磁盘源文件均会保留。";
                            color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center;
                        }
                    }
                    Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 10px;
                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        ActionButton { width: 84px; text: "取消"; clicked => { root.delete-group-confirm-open = false; } }
                        ActionButton {
                            width: 104px;
                            text: "确认删除";
                            danger: true;
                            clicked => {
                                root.delete-group-confirm-open = false;
                                root.delete-library-group(root.delete-group-confirm-id);
                            }
                        }
                    }
                }
            }
        }

        if root.remove-confirm-open : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #11182778;
            modal-blocker := TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(470px, parent.width - 48px);
                height: 270px;
                border-radius: 16px;
                border-width: 1px;
                border-color: DesignTokens.border-subtle;
                background: DesignTokens.surface;

                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 24px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 46px;
                        spacing: 13px;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 21px;
                            background: #fff1f0;
                            Text { text: "−"; color: #c63b32; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "从书库移除"; color: DesignTokens.text-primary; font-size: 19px; font-weight: DesignTokens.weight-page-title; vertical-alignment: center; }
                            Text { text: "此操作不会删除电脑中的原书文件"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; vertical-alignment: center; }
                        }
                    }
                    Text { height: 30px; text: "确定移除《" + root.remove-confirm-title + "》吗？"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; font-weight: DesignTokens.weight-item-title; wrap: word-wrap; vertical-alignment: center; }
                    Rectangle {
                        height: 64px;
                        border-radius: 9px;
                        background: DesignTokens.surface-subtle;
                        Text {
                            x: 13px; y: 10px; width: parent.width - 26px; height: parent.height - 20px;
                            text: "将清除这本书的书库记录、阅读进度、书签和最近打开信息；源 TXT / EPUB 文件保持不变。";
                            color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center;
                        }
                    }
                    Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 10px;
                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        ActionButton { width: 84px; text: "取消"; clicked => { root.remove-confirm-open = false; } }
                        ActionButton {
                            width: 104px;
                            text: "确认移除";
                            danger: true;
                            clicked => {
                                root.remove-confirm-open = false;
                                root.remove-library-book(root.remove-confirm-path, root.remove-confirm-title);
                            }
                        }
                    }
                }
            }
        }

        if root.dirty-confirm-open : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #11182778;
            dirty-modal-blocker := TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(520px, parent.width - 48px);
                height: 250px;
                border-radius: 16px;
                border-width: 1px;
                border-color: DesignTokens.border-subtle;
                background: DesignTokens.surface;
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 24px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    Text { height: 30px; text: "保存修改？"; color: DesignTokens.text-primary; font-size: 19px; font-weight: DesignTokens.weight-page-title; vertical-alignment: center; }
                    Text { height: 48px; text: "《" + root.dirty-confirm-title + "》有尚未保存的正文修改。"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; wrap: word-wrap; vertical-alignment: center; }
                    Text { height: 42px; text: "保存会安全写入磁盘；放弃修改会恢复最近一次成功保存的版本；取消则留在当前编辑位置。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center; }
                    Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 10px;
                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        ActionButton { width: 80px; text: "取消"; clicked => { root.resolve-dirty-decision("cancel"); } }
                        ActionButton { width: 104px; text: "放弃修改"; danger: true; clicked => { root.resolve-dirty-decision("discard"); } }
                        ActionButton { width: 112px; text: "保存并继续"; primary: true; clicked => { root.resolve-dirty-decision("save"); } }
                    }
                }
            }
        }

        if root.save-conflict-open : Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: #11182778;
            conflict-modal-blocker := TouchArea { }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(540px, parent.width - 48px);
                height: 252px;
                border-radius: 16px; border-width: 1px; border-color: DesignTokens.border-subtle; background: DesignTokens.surface;
                VerticalLayout {
                    padding-left: 26px; padding-right: 26px; padding-top: 24px; padding-bottom: 22px; spacing: 12px;
                    Text { height: 30px; text: "文件已在外部修改"; color: DesignTokens.text-primary; font-size: 19px; font-weight: DesignTokens.weight-page-title; vertical-alignment: center; }
                    Text { height: 62px; text: root.save-conflict-message; color: DesignTokens.text-secondary; font-size: DesignTokens.type-item-title; wrap: word-wrap; vertical-alignment: center; }
                    Text { height: 36px; text: "Readloom 不会强制覆盖。可另存草稿，或重新加载磁盘版本并放弃当前草稿。"; color: DesignTokens.text-muted; font-size: DesignTokens.type-secondary; wrap: word-wrap; vertical-alignment: center; }
                    Rectangle { min-height: 0px; preferred-height: 0px; vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 36px; spacing: 10px;
                        Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; background: transparent; }
                        ActionButton { width: 76px; text: "取消"; clicked => { root.resolve-save-conflict("cancel"); } }
                        ActionButton { width: 122px; text: "重新加载外部版本"; danger: true; clicked => { root.resolve-save-conflict("reload"); } }
                        ActionButton { width: 92px; text: "另存为"; primary: true; clicked => { root.resolve-save-conflict("save-as"); } }
                    }
                }
            }
        }
    }
}
