                                        height: pair.second.kind == "blank" ? parent.height : Math.max(root.settings-font-size * 1px, parent.height - self.y - 5px);
                                        accessible-id: "inline-editor-" + pair.second.block-id;
                                        text <=> pair-row.second-live-edit-text; single-line: false; wrap: word-wrap; color: DesignTokens.reader-text;
                                        selection-background-color: DesignTokens.accent-muted; selection-foreground-color: DesignTokens.reader-text;
                                        font-family: root.document-kind == "EPUB" && !root.settings-epub-override-font ? "Microsoft YaHei UI" : root.settings-font-family;
                                        font-size: root.document-kind == "EPUB" && !root.settings-epub-override-font-size ? 18px : root.settings-font-size * 1px;
                                        font-weight: root.settings-font-weight;
