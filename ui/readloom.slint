                                        edited => {
                                            root.active-paragraph-index = paragraph.index;
                                            root.replace-block-text(paragraph.block-id, self.text, self.cursor-position_byte-offset);
                                        }
                                        key-pressed(event) => {
                                            if self.preedit-text.is-empty && self.cursor-position-byte-offset == self.anchor-position-byte-offset {
                                                if event.text == Key.Backspace && root.join-adjacent-text(paragraph.block-id, "previous", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) {
                                                    return accept;
                                                }
                                                if event.text == Key.Delete && root.join-adjacent-text(paragraph.block-id, "next", self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset) {
                                                    return accept;
                                                }
                                            }
                                            return reject;
                                        }
