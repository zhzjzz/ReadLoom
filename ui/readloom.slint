                                                + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                                + 20px)
                                        : Math.max(
                                            pair.first.editable ? Math.max(self.first-live-editor-height, first-body.preferred-height) : first-body.preferred-height,
                                            pair.has-second ? Math.max(self.second-live-editor-height, second-body.preferred-height) : 0px
                                          ) * (root.document-kind == "EPUB" && !root.settings-epub-override-line-height ? 1.7 : root.settings-line-height) / 1.2
                                            + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                            + 20px
                                        : pair.first.kind == "heading"
                                            ? 76px + root.settings-paragraph-spacing * root.settings-font-size * 1px
                                            : Math.max(first-body.preferred-height, root.settings-font-size * 4px) * (root.document-kind == "EPUB" && !root.settings-epub-override-line-height ? 1.7 : root.settings-line-height) / 1.2
                                                + (root.document-kind == "EPUB" && !root.settings-epub-override-paragraph-spacing ? 0.15 : root.settings-paragraph-spacing) * root.settings-font-size * 1px
                                                + 20px;
                                    background: pair.first.index == root.active-paragraph-index || (pair.has-second && pair.second.index == root.active-paragraph-index)
                                        ? (root.settings-effective-theme == "dark" ? #315fc428 : #315fc418) : transparent;
                                    changed measure-generation => {
                                        root.report-block-geometry(pair.first.block-id, self.y / 1px, self.height / 1px);
                                        if (pair.has-second) { root.report-block-geometry(pair.second.block-id, self.y / 1px, self.height / 1px); }
                                    }
                                    first-body := Text {
                                        visible: pair.first.kind != "image" && (!root.edit-mode || !pair.first.editable);
                                        x: 0px;
                                        y: pair.first.kind == "heading" ? 18px : 13px;
                                        width: pair.first.kind == "heading"
                                            ? parent.width
                                            : (parent.width - 28px) / 2;
                                        text: pair.first.kind == "paragraph" && ((root.document-kind == "TXT" && root.settings-txt-leading-indent == "clean") || (root.document-kind == "EPUB" && root.settings-epub-override-indent))
                                            ? root.settings-indent-prefix + pair.first.text : pair.first.text;
