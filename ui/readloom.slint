                                        x: (parent.width - 28px) / 2 + 28px + Math.max(100px, (parent.width - 28px) / 2 - 88px) + 6px; y: 304px; width: 82px; height: 34px; text: "删除图片";
                                        clicked => { root.active-paragraph-index = pair.second.index; root.remove-epub-image(pair.second.block-id); }
                                    }
