                                        font-weight: pair.first.kind == "heading" ? 700 : root.settings-font-weight;
                                        letter-spacing: pair.first.kind == "heading" ? 0px : (root.settings-letter-spacing + (root.settings-text-alignment == "justify" ? 0.02 : 0)) * root.settings-font-size * 1px;
                                        horizontal-alignment: pair.first.kind == "heading" ? center : left;
                                        wrap: word-wrap;
                                    }
