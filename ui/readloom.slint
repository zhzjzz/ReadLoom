                                        width: (parent.width - 28px) / 2;
                                        height: 270px;
                                        source: pair.second.image;
                                        image-fit: contain;
                                    }
                                    if root.edit-mode && pair.first.kind == "image" : first-image-alt := LineEdit {
                                        x: 0px; y: 304px; width: Math.max(100px, (parent.width - 28px) / 2 - 88px); height: 34px;
                                        accessible-id: "image-alt-editor-" + pair.first.block-id;
                                        text: pair.first.text; placeholder-text: "图片替代文本";
                                        edited => { root.active-paragraph-index = pair.first.index; root.set-epub-image-alt(pair.first.block-id, self.text); }
                                    }
                                    if root.edit-mode && pair.first.kind == "image" : ActionButton {
                                        x: Math.max(100px, (parent.width - 28px) / 2 - 88px) + 6px; y: 304px; width: 82px; height: 34px; text: "删除图片";
                                        clicked => { root.active-paragraph-index = pair.first.index; root.remove-epub-image(pair.first.block-id); }
