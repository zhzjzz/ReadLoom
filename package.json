{
  "name": "readloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:exe": "tauri build --no-bundle --features custom-protocol",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "slint:check": "cargo check -p readloom",
    "slint:run": "cargo run -p readloom",
    "slint:build": "cargo build -p readloom --release",
    "slint:verify": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && cargo build --release --workspace && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-gui-subsystem.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-blockquote": "3.29.2",
    "@tiptap/extension-bold": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-heading": "3.29.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-italic": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-paragraph": "3.29.2",
    "@tiptap/extension-strike": "3.29.2",
    "@tiptap/extension-subscript": "3.29.2",
    "@tiptap/extension-superscript": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.3",
    "jsdom": "29.0.0",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
